#!/bin/bash
# Linux equivalent of cr-native-sandbox/runtime.env.example.ps1. Same variable NAMES, which is the whole
# reason worker.py needs no config changes -- worker.py:27-37 already resolves every path from CR_SANDBOX_*
# with no personal fallback.
#
#   cp runtime.env.sh.example ~/cr-sandbox/runtime.env.sh   # then edit, then: source runtime.env.sh
#
# Nothing here is a secret, but nothing here should be committed either: the paths point at the
# non-redistributable runtime bundle.

SANDBOX_ROOT=${SANDBOX_ROOT:-$HOME/cr-native-sandbox}
export ANDROID_SDK_ROOT=${ANDROID_SDK_ROOT:-$HOME/android-sdk}
export ANDROID_HOME=$ANDROID_SDK_ROOT

export CR_SANDBOX_ADB="$ANDROID_SDK_ROOT/platform-tools/adb"
export CR_SANDBOX_EMULATOR="$ANDROID_SDK_ROOT/emulator/emulator"

# The 1.15 GB runtime bundle -- obtained legally by the operator, never in git, never redistributed.
export CR_SANDBOX_RUNTIME_DIR="$SANDBOX_ROOT/runtime/x86_64-libs"          # 14 .so incl. libg.so
export CR_SANDBOX_BASE_APK="$SANDBOX_ROOT/runtime/apks/base.apk"
export CR_SANDBOX_ASSET_PACK_APK="$SANDBOX_ROOT/runtime/apks/asset_pack.apk"
export CR_SANDBOX_ASSETS="$SANDBOX_ROOT/runtime/extracted-assets"           # 383 DataTables CSVs
export CR_SANDBOX_DATA="$SANDBOX_ROOT/data"

# Sanity, because the failure mode of a wrong path here is a service that starts and instantly exits.
for v in CR_SANDBOX_ADB CR_SANDBOX_BASE_APK CR_SANDBOX_ASSET_PACK_APK; do
  eval "p=\$$v"; [ -f "$p" ] || echo "runtime.env.sh: $v does not exist: $p" >&2
done
[ -f "$CR_SANDBOX_RUNTIME_DIR/libg.so" ] || echo "runtime.env.sh: libg.so missing under CR_SANDBOX_RUNTIME_DIR" >&2
[ -d "$CR_SANDBOX_ASSETS" ] || echo "runtime.env.sh: CR_SANDBOX_ASSETS is not a directory" >&2
