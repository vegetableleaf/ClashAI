+/// LOCAL PATCH (ClashBot): triple elixir in the last TRIPLE_ELIXIR_LAST_S seconds of overtime (tick 4800 of 6000 at
+/// REGULAR_TIME_S 180 / OVERTIME_S 120 / TICK_MS 50), as the real engine does.
+pub const TRIPLE_ELIXIR_LAST_S: i64 = 60;
+
+pub fn triple_elixir(overtime: bool, elapsed_ms: i64, regular_ms: i64, overtime_s: i32) -> bool {
+    overtime && elapsed_ms >= regular_ms + ((overtime_s as i64) - TRIPLE_ELIXIR_LAST_S).max(0) * 1000
+}
