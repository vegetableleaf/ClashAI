+package org.crforge.core.battle.action;
+
+import org.crforge.core.fidelity.Fidelity;
+import org.crforge.core.fidelity.FidelityStatus;
+
+/**
+ * The hero ability's delivery mark (ActionAbilityDelivered, data 16.635.3): the champion slot of the
+ * owner's side that follows the character it runs on stops waiting for the delivery, so the use's
+ * cost is no longer given back when the last copy leaves. Nothing without such a slot. It has no
+ * run: it does what it does as it starts, and its next action follows as for any row.
+ *
+ * <p>Clashbot fork F635: the rows came with RefundUntilDelivered on the five hero abilities and
+ * RefundWindow taken off them; the class's code is not read, so the mark is inferred from the
+ * tables (b).
+ */
+@Fidelity(
+    status = FidelityStatus.PARTIAL,
+    note =
+        "Inferred from the 16.635.3 tables (clashbot fork F635): the slot that follows the"
+            + " character stops waiting for the delivery; held by BattleChampionRefundTest. Refused"
+            + " on an owner other than a character.")
+public final class AbilityDelivered extends RowAction {
+
+  /**
+   * @param row the row's shared columns
+   */
+  public AbilityDelivered(ActionRow row) {
+    super(row);
+  }
+
+  @Override
+  public ActionInstance start(ActionHolder holder) {
+    holder.getOwner().abilityDelivered(this);
+    return null;
+  }
+}
