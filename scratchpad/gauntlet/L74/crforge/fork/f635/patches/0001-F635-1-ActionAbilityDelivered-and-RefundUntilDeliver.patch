+
+  /** An ability row as data 16.635.3 writes the hero abilities': no RefundWindow, refunded until delivered. */
+  private static Consumer<ObjectNode> untilDelivered(int triggerDelay, String onActivation) {
+    return row -> {
+      row.remove("RefundWindow");
+      row.put("RefundUntilDelivered", true).put("TriggerDelay", triggerDelay).put("CastTime", 2000);
+      if (onActivation != null) {
+        row.put("OnActivationAction", onActivation);
+      }
+    };
+  }
+
+  /** The delivery mark, as data 16.635.3 writes the hero abilities' *_ability_delivered rows. */
+  private static final String DELIVERED = "Test_ability_delivered";
+
+  private static void addDelivered(ObjectNode rows) {
+    ObjectNode row = rows.putObject(DELIVERED);
+    row.put("class", "LogicActionAbilityDeliveredData");
+    row.put("ClassType", "ActionAbilityDelivered");
+    row.putObject("fields").put("ClassType", "ActionAbilityDelivered");
+  }
+
+  @Test
+  @DisplayName(
+      "clashbot F635: an ability row refunded until delivered, with no delivery, gives the cost"
+          + " back at a death long past its trigger delay")
+  void untilDeliveredHoldsPastTheTriggerDelay(@TempDir Path folder) throws IOException {
+    Scene scene = new Scene(folder, untilDelivered(200, null));
+    CharacterEntity queen = scene.playQueen(0);
+    scene.afterDeployWithElixir();
+    scene.useAbility();
+    // 1,000 ms on she still casts: a window of the trigger delay would have run out.
+    scene.step(20);
+    assertThat(queen.getView().getState()).isEqualTo(ChampionController.CASTING);
+    scene.kill(queen);
+    int cost = scene.battle.getWorld().getRecords().unit(QUEEN).ability().manaCost();
+    assertThat(scene.refunds).hasSize(1);
+    assertThat(scene.refunds.get(0)).startsWith(cost + " ");
+  }
+
+  @Test
+  @DisplayName(
+      "clashbot F635: the delivery mark run as the ability fires shuts the window: a death before"
+          + " it is refunded, a death after it is not")
+  void theDeliveryMarkShutsTheWindow(@TempDir Path folder) throws IOException {
+    Scene before =
+        new Scene(
+            Files.createDirectories(folder.resolve("before")),
+            untilDelivered(500, DELIVERED),
+            BattleChampionRefundTest::addDelivered);
+    CharacterEntity queen = before.playQueen(0);
+    before.afterDeployWithElixir();
+    before.useAbility();
+    before.kill(queen);
+    assertThat(before.refunds).hasSize(1);
+
+    Scene after =
+        new Scene(
+            Files.createDirectories(folder.resolve("after")),
+            untilDelivered(100, DELIVERED),
+            BattleChampionRefundTest::addDelivered);
+    queen = after.playQueen(0);
+    after.afterDeployWithElixir();
+    after.useAbility();
+    // Past the trigger delay: the ability fired and ran the mark; she still casts.
+    after.step(6);
+    assertThat(queen.getView().getState()).isEqualTo(ChampionController.CASTING);
+    after.kill(queen);
+    assertThat(after.refunds).isEmpty();
+  }
 }
