-    unit.raiseWatched(bits().noAttack() | bits().noMove());
+    hold = row.tags() != 0 ? 0 : bits().noAttack() | bits().noMove();
+    if (hold != 0) {
+      unit.raiseWatched(hold);
+    }
     target = unit.currentTarget();
     if (target == null) {
       throw new UnsupportedOperationException(
@@ -126,7 +137,7 @@ final class UppercutRun extends ActionInstance {
         outcome = "push refused";
         finish();
       } else {
-        unit.raiseWatched(bits().noAttack() | bits().noMove() | bits().lockTarget());
+        unit.raiseWatched(hold | bits().lockTarget());
         delay = row.getDashFollowUpDelayMs();
         if (delay != 0) {
           outcome = "pushed";
@@ -159,7 +170,9 @@ final class UppercutRun extends ActionInstance {
     }
     delay -= STEP_MS;
     if (delay > 0) {
-      unit.raiseWatched(bits().noMove() | bits().noAttack());
+      if (hold != 0) {
