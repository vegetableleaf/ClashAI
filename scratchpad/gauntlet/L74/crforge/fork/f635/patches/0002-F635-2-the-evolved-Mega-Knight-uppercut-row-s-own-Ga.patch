 .../crforge/core/battle/unit/UppercutRun.java | 19 +++++-
 .../battle/unit/BattleHeldDasherStunTest.java |  6 ++
 .../battle/unit/BattleUppercutWindTest.java   | 68 +++++++++++++++++--
 4 files changed, 91 insertions(+), 11 deletions(-)

diff --git a/core/src/main/java/org/crforge/core/battle/data/ActionRows.java b/core/src/main/java/org/crforge/core/battle/data/ActionRows.java
index d3e297fd..cedb2404 100644
--- a/core/src/main/java/org/crforge/core/battle/data/ActionRows.java
+++ b/core/src/main/java/org/crforge/core/battle/data/ActionRows.java
@@ -2485,7 +2485,14 @@ public final class ActionRows {
      */
     private MegaKnightUppercut uppercut(String name, ActionRow shared, JsonNode f) {
       // The start gate is the runtime's: asked as the uppercut starts, before its hold and target.
-      refuseUnread(name, f, true, true);
+      // Data 16.635.3 writes the hold's tags in the row (NO_ATTACK, NO_MOVE_ALLOW_ATTRACT): its run
+      // carries them while listed, in place of the coded NO_ATTACK and NO_MOVE (clashbot F635).
+      JsonNode unread = f;
+      if (f.has("GameTagsToSet")) {
+        unread = f.deepCopy();
+        ((com.fasterxml.jackson.databind.node.ObjectNode) unread).remove("GameTagsToSet");
+      }
+      refuseUnread(name, unread, true, true);
       if (!bool(f, "IgnorePushbackChecks", false)) {
         throw new UnsupportedOperationException(
             name + " pushes through the pushback request's gates, which is not modelled");
