+package org.crforge.core.battle.unit;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import com.fasterxml.jackson.databind.JsonNode;
+import com.fasterxml.jackson.databind.node.ObjectNode;
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import org.crforge.core.battle.GameData;
+import org.crforge.core.battle.data.GameTables;
+import org.junit.jupiter.api.DisplayName;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+/**
+ * Clashbot fork F635: data 16.635.3 gives the hero Electro Wizard's surge entries of its attack
+ * sequence CustomBuffOnDamageTime 600, in place of the row's BuffOnDamageTime 500, for the stun
+ * each of their hits leaves. An entry's hit stuns for the entry's time; an entry without one, for
+ * the row's.
+ */
+class BattleCustomBuffOnDamageTimeTest {
+
+  private static final int LEVEL = Standard1v1Battle.DEFAULT_LEVEL;
+
+  private static final String WIZARD = "ElectroWizardHero";
+
+  /**
+   * The hero Electro Wizard's row with every entry of its attack sequence given the custom time, or
+   * none for -1.
+   */
+  private static GameTables entriesAt(Path folder, int time) throws IOException {
+    return GameData.altered(
+        folder,
+        "characters",
+        rows -> {
+          ObjectNode row = GameData.columns(rows, WIZARD);
+          for (JsonNode element : row.withArray("AttackSequenceList")) {
+            ObjectNode entry = (ObjectNode) element;
+            if (time < 0) {
+              entry.remove("CustomBuffOnDamageTime");
+            } else {
+              entry.put("CustomBuffOnDamageTime", time);
+            }
+          }
+        });
+  }
+
+  /** The whole time of the first stun the wizard's own hit lists on a held Knight. */
+  private static int firstStunTime(GameTables tables) {
+    Standard1v1Battle match = new Standard1v1Battle(tables, LEVEL, false);
+    CharacterEntity wizard =
+        match.deploy(0, match.getWorld().getRecords().unit(WIZARD), LEVEL, 0, 9000, 14000, "W");
+    CharacterEntity knight =
+        match.deploy(0, match.getWorld().getRecords().unit("Knight"), LEVEL, 1, 9000, 18500, "K");
+    knight.setActive(CharacterEntity.MOVEMENT_SLOT, false);
+    knight.setActive(CharacterEntity.TARGETING_SLOT, false);
+    String stun = wizard.getData().buffOnDamage();
+    int[] first = {-1};
+    match
+        .getWorld()
+        .addObserver(
+            new WorldObserver() {
+              @Override
+              public void buffApplied(int tick, WorldEntity target, BuffInstance buff) {
+                if (first[0] < 0
+                    && target == knight
+                    && buff.getBuff().name().equals(stun)
+                    && buff.getSource() == wizard) {
+                  first[0] = buff.getTotal();
+                }
+              }
+            });
+    for (int t = 0; t < 200 && first[0] < 0; t++) {
+      match.getBattle().step();
+    }
+    return first[0];
+  }
+
+  @Test
+  @DisplayName(
+      "clashbot F635: a hit of an attack sequence entry with CustomBuffOnDamageTime stuns for the"
+          + " entry's time; without it, for the row's BuffOnDamageTime")
+  void theEntryTimesTheStun(@TempDir Path folder) throws IOException {
+    assertThat(firstStunTime(entriesAt(Files.createDirectories(folder.resolve("custom")), 600)))
+        .isEqualTo(600);
+    // The row's BuffOnDamageTime, 500 in both data versions.
+    assertThat(firstStunTime(entriesAt(Files.createDirectories(folder.resolve("row")), -1)))
+        .isEqualTo(500);
+  }
+}
