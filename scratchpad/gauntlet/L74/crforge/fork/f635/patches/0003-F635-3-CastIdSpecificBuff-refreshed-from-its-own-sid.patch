+package org.crforge.core.battle.unit;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import com.fasterxml.jackson.databind.node.ObjectNode;
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import org.crforge.core.battle.GameData;
+import org.crforge.core.battle.data.GameTables;
+import org.junit.jupiter.api.DisplayName;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+/**
+ * Clashbot fork F635: data 16.635.3 puts CastIdSpecificBuff in PlayerSpecificBuff's place on the
+ * evolved Firecracker's fireworks and the evolved Cannon's barrage. An instance is then refreshed
+ * only from its own side and the same play: two evolved Firecrackers of one side, from two plays,
+ * burn one target twice over, where the player-specific row burns it once.
+ */
+class BattleCastIdSpecificBuffTest {
+
+  private static final int LEVEL = Standard1v1Battle.DEFAULT_LEVEL;
+
+  /** The evolved Firecracker's fireworks' buff. */
+  private static final String BURN = "FirecrackerFireworks_EV1";
+
+  /** The row as data 16.635.3 writes it. */
+  private static GameTables castIdSpecific(Path folder) throws IOException {
+    return GameData.altered(
+        folder,
+        "character_buffs",
+        rows -> {
+          ObjectNode row = GameData.columns(rows, BURN);
+          row.remove("PlayerSpecificBuff");
+          row.put("CastIdSpecificBuff", true);
+        });
+  }
+
+  /** The row as data 16.402.22 writes it. */
+  private static GameTables playerSpecific(Path folder) throws IOException {
+    return GameData.altered(
+        folder,
+        "character_buffs",
+        rows -> {
+          ObjectNode row = GameData.columns(rows, BURN);
+          row.remove("CastIdSpecificBuff");
+          row.put("PlayerSpecificBuff", true);
+        });
+  }
+
+  /**
+   * Two evolved Firecrackers of the bottom side, the given plays, shooting one held Barbarian of
+   * the top side: the most instances of the burn it carries at once over the first 200 ticks.
+   */
+  private static int mostBurnsAtOnce(GameTables tables, int playA, int playB) {
+    Standard1v1Battle match = new Standard1v1Battle(tables, LEVEL, false);
+    CharacterEntity a =
+        match.deploy(0, match.getWorld().getRecords().unit("Firecracker_EV1"), LEVEL, 0, 9000,
+            13000, "FA");
+    CharacterEntity b =
+        match.deploy(0, match.getWorld().getRecords().unit("Firecracker_EV1"), LEVEL, 0, 9000,
+            15000, "FB");
+    a.setDeployIndex(playA);
+    b.setDeployIndex(playB);
+    CharacterEntity target =
+        match.deploy(0, match.getWorld().getRecords().unit("Barbarian"), LEVEL, 1, 4500, 14000,
+            "B");
+    target.setActive(CharacterEntity.MOVEMENT_SLOT, false);
+    target.setActive(CharacterEntity.TARGETING_SLOT, false);
+    int most = 0;
+    for (int t = 0; t < 200 && !target.isRemovable(); t++) {
+      match.getBattle().step();
+      int burns =
+          (int) target.getBuffs().items().stream()
+              .filter(i -> i.getBuff().name().equals(BURN))
+              .count();
+      most = Math.max(most, burns);
+    }
+    return most;
+  }
+
+  @Test
+  @DisplayName(
+      "clashbot F635: the cast-id-specific burn from two plays of one side lists two instances on"
+          + " one target; from one play, one")
+  void twoPlaysBurnTwice(@TempDir Path folder) throws IOException {
+    assertThat(mostBurnsAtOnce(castIdSpecific(Files.createDirectories(folder.resolve("two"))), 4, 6))
+        .isEqualTo(2);
+    assertThat(mostBurnsAtOnce(castIdSpecific(Files.createDirectories(folder.resolve("one"))), 4, 4))
+        .isEqualTo(1);
+  }
+
+  @Test
+  @DisplayName("the player-specific burn (data 16.402.22) lists one instance from two plays")
+  void playerSpecificBurnsOnce(@TempDir Path folder) throws IOException {
+    assertThat(mostBurnsAtOnce(playerSpecific(folder), 4, 6)).isEqualTo(1);
+  }
+}
