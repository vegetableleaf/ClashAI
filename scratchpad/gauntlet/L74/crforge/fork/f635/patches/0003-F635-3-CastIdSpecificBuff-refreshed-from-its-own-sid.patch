+  /**
+   * The play behind a source, as a buff specific to its cast id reads it (clashbot fork F635, from
+   * the 16.635.3 tables, b): a unit's own play, the play a projectile carries, or for a unit's
+   * shot, which carries none here, its root's (the stamp the launch copies from its owner); for a
+   * projectile an area effect launched (the evolved Cannon's bombs), that area effect's; an area
+   * effect's, the play its creation handed it. An area effect made where no play is handed is
+   * refused for such a buff.
+   *
+   * @param source what applies the buff
+   * @param buff the buff, named in the refusal
+   * @return the play, by its king's count of card plays before it; -1 for none
+   */
+  static int castPlay(SpawnHost source, BuffData buff) {
+    int play = playOf(source);
+    if (play == AreaEffectEntity.PLAY_UNKNOWN) {
+      throw new UnsupportedOperationException(
+          buff.name()
+              + " is specific to its cast id and is applied by "
+              + source.name()
+              + ", an area effect whose play is not known, which is not modelled");
+    }
+    return play;
+  }
+
+  /**
+   * The play behind a source, as {@link #castPlay(SpawnHost, BuffData)} reads it, with {@link
+   * AreaEffectEntity#PLAY_UNKNOWN} for an area effect handed none.
+   *
+   * @param source what applies the buff
+   * @return the play; -1 for none
+   */
+  static int playOf(SpawnHost source) {
+    if (source instanceof CharacterEntity unit) {
+      return unit.getDeployIndex();
+    }
+    if (source instanceof ProjectileEntity projectile) {
+      if (projectile.isAreaLaunched()) {
+        return projectile.getAreaLaunchPlay();
+      }
+      if (projectile.getDeployIndex() != -1) {
+        return projectile.getDeployIndex();
+      }
+      return projectile.getRoot() instanceof CharacterEntity unit ? unit.getDeployIndex() : -1;
+    }
+    if (source instanceof AreaEffectEntity area) {
+      return area.getCastPlay();
+    }
+    return -1;
+  }
+
