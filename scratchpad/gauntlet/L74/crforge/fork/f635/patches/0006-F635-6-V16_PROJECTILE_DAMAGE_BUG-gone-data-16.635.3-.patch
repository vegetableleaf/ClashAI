  * When the travelling hit of a projectile flying to a point lands its damage, seen through a Hunter
@@ -38,11 +43,42 @@ import org.junit.jupiter.api.Test;
  * projectile's hit on its one target adds its damage, as the travelling hits do, while a
  * damage-taking action's hit adds nothing, its amount being worked out only at the drain. The scene
  * is played again with one such hit queued for the ram just before the tick of its death.
+ *
+ * <p>All of this is the rule of the global V16_PROJECTILE_DAMAGE_BUG set, as data 16.402.x
+ * publishes it; those scenes set it whatever the tables. Data 16.635.3 drops the global (clashbot
+ * fork F635): a pellet then dooms the ram only with its own damage.
  */
 class BattleTravellingHitDrainTest {
 
   private static final int LEVEL = Standard1v1Battle.DEFAULT_LEVEL;
 
+  private static final String BUG = "V16_PROJECTILE_DAMAGE_BUG";
+
+  /** The tables with the global set, as data 16.402.x publishes it; added when they have none. */
+  private static GameTables bugSet(Path folder) throws IOException {
+    return GameData.altered(
+        folder,
+        "globals",
+        rows -> {
+          if (!rows.has(BUG)) {
+            int index = 0;
+            for (JsonNode row : rows) {
+              index = Math.max(index, row.path("index").asInt() + 1);
+            }
+            ObjectNode row = rows.putObject(BUG);
+            row.put("class", "LogicData");
+            row.put("index", index);
+            row.putObject("columns").put("Name", BUG);
+          }
+          GameData.columns(rows, BUG).put("BooleanValue", true);
+        });
+  }
+
+  /** The tables without the global, as data 16.635.3 publishes them. */
+  private static GameTables bugGone(Path folder) throws IOException {
+    return GameData.altered(folder, "globals", rows -> rows.remove(BUG));
+  }
+
   /** Long enough for the ram to walk into the Hunter's reach and die. */
   private static final int TICKS = 600;
 
