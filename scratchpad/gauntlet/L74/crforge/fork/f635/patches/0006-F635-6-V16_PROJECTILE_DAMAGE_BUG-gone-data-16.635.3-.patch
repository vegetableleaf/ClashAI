   }
+
+  @Test
+  @DisplayName(
+      "clashbot F635: with V16_PROJECTILE_DAMAGE_BUG gone (data 16.635.3) a pellet dooms the ram"
+          + " only with its own damage: every pellet of the killing volley stops at it, a kill-sized"
+          + " hit queued before them included")
+  void withTheGlobalGoneOnlyThePelletsOwnDamageDooms(@TempDir Path folder) throws IOException {
+    GameTables tables = bugGone(folder);
+    int pellets = number(unitRow("Hunter"), "MultipleProjectiles");
+    List<Integer> pelletDamage = new ArrayList<>();
+    Death plain = scene(tables);
+    assertThat(plain.volleyPellets()).isEqualTo(pellets);
+    assertThat(plain.pelletsFlyingOn()).isZero();
+    Death queued =
+        scene(
+            tables,
+            plain.tick(),
+            (world, recording) -> {
+              ProjectileEntity projectile = recording.pellets.get(0);
+              // No pellet alone kills the ram here: the rule under test is the queued total's.
+              pelletDamage.add(projectile.undeflectedDamage());
+              assertThat(projectile.undeflectedDamage()).isLessThan(whole(recording.ram));
+              world.dealProjectileHit(
+                  projectile, recording.ram, whole(recording.ram), world.nextHitId(), 0, 0);
+            });
+    assertThat(pelletDamage).hasSize(1);
+    assertThat(queued.tick()).isEqualTo(plain.tick());
+    assertThat(queued.volleyPellets()).isEqualTo(pellets);
+    assertThat(queued.pelletsFlyingOn()).isZero();
+  }
