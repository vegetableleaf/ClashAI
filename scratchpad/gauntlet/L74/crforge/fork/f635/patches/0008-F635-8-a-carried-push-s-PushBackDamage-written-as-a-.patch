   }
 
+  @Test
+  @DisplayName(
+      "clashbot F635: a carried push's damage written as a damage table (data 16.635.3) reads as"
+          + " its BaseDamage with no flag or the flag NoCounter; another flag or field is refused")
+  void aCarriedPushDamageTableIsRead(@TempDir Path folder) throws IOException {
+    String row = "BattleRam_EV1_PushBack";
+    Map<String, Consumer<ObjectNode>> read =
+        new TreeMap<>(
+            Map.of(
+                "NoCounter", d -> d.put("Flags", "NoCounter"),
+                "NoCounter_listed", d -> d.putArray("Flags").add("NoCounter"),
+                "no_flag", d -> {}));
+    Map<String, Consumer<ObjectNode>> refused =
+        new TreeMap<>(
+            Map.of(
+                "Reflected", d -> d.put("Flags", "NoCounter,Reflected"),
+                "TowerDamage", d -> d.put("TowerDamage", 10)));
+    for (boolean reads : new boolean[] {true, false}) {
+      for (Map.Entry<String, Consumer<ObjectNode>> form : (reads ? read : refused).entrySet()) {
+        Path dir = Files.createDirectories(folder.resolve(form.getKey()));
+        GameTables altered =
+            GameData.altered(
+                dir,
+                "actions",
+                rows -> {
+                  ObjectNode damage =
+                      ((ObjectNode) rows.get(row).get("fields")).putObject("PushBackDamage");
+                  damage.put("BaseDamage", 91);
+                  form.getValue().accept(damage);
+                });
+        ActionRows rows = new ActionRows(altered, new BattleRecords(altered));
+        if (reads) {
+          DamagingPushBack built = (DamagingPushBack) rows.build(row, INERT_BINDING);
+          assertThat(built.getColumns().pushBackDamage()).as(form.getKey()).isEqualTo(91);
+        } else {
+          assertThatThrownBy(() -> rows.build(row, INERT_BINDING))
+              .as(form.getKey())
+              .isInstanceOf(UnsupportedOperationException.class)
+              .hasMessageContaining(form.getKey());
+        }
+      }
+    }
+  }
+
