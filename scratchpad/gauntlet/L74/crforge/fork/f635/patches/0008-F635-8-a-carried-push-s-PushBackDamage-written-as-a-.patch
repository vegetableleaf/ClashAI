@@ -3999,6 +3999,44 @@ public final class ActionRows {
           flags.contains("DamagesHidden"));
     }
 
+    /**
+     * A carried push's damage: a number, as data 16.402.x writes it, or a damage table of
+     * BaseDamage and the flag NoCounter, as data 16.635.3 writes the evolved Battle Ram's (clashbot
+     * fork F635): its BaseDamage, the push's hit dealt as the number's was. What NoCounter turns off
+     * is not read from the game (b): the 16.402.x push's hit takes no hit id from the battle's
+     * counter, and the flag is read as keeping it so. Refused: another field or flag.
+     */
+    private int pushBackDamage(String name, JsonNode f) {
+      JsonNode value = f.get("PushBackDamage");
+      if (value == null || !value.isObject()) {
+        return integer(f, "PushBackDamage");
+      }
+      for (Iterator<String> it = value.fieldNames(); it.hasNext(); ) {
+        String field = it.next();
+        if (!Set.of("BaseDamage", "Flags").contains(field)) {
+          throw new UnsupportedOperationException(
+              name + " sets " + field + " in its PushBackDamage, which is not modelled");
+        }
+      }
+      JsonNode written = value.get("Flags");
+      List<String> flags = new ArrayList<>();
+      if (written != null && written.isArray()) {
+        written.forEach(flag -> flags.add(flag.asText()));
+      } else if (written != null && !written.isNull()) {
+        flags.addAll(List.of(written.asText().split(",")));
+      }
+      for (String flag : flags) {
+        if (!flag.isBlank() && !flag.trim().equals("NoCounter")) {
+          throw new UnsupportedOperationException(
+              name
+                  + " sets the damage flag "
+                  + flag.trim()
+                  + " in its PushBackDamage, which is not modelled");
+        }
+      }
+      return integer(value, "BaseDamage", 0);
+    }
+
