+  /**
+   * Runs a scene to the first child, then casts a Clone on the Skeleton on the next tick and steps
+   * to the tick that copies the duplication onto the clone.
+   */
+  private static Scene clonedAfterTheFirstChild(GameTables tables) {
+    Scene scene = new Scene(tables);
+    scene.still(0, SKELETON, 9000, 12000, "skeleton");
+    scene.target = scene.still(1, "Giant", 9600, 13200, "giant");
+    for (int i = 0; i < 60 && scene.children.isEmpty(); i++) {
+      scene.step(1);
+    }
+    assertThat(scene.children).hasSize(1);
+    scene.match.placeAreaEffect(
+        scene.match.getBattle().getTick(), "Clone", LEVEL, 0, 9000, 12000, "C");
+    for (int i = 0; i < 20 && scene.copies.isEmpty(); i++) {
+      scene.step(1);
+    }
+    return scene;
+  }
+
+  @Test
+  @DisplayName(
+      "a Clone of a Skeleton whose duplication has fired copies the spent spawner: the copy is"
+          + " listed on the clone with no firing left, and the clone makes nothing")
+  void aCloneCopiesTheSpentSpawner() {
+    Scene scene = clonedAfterTheFirstChild(tables);
+
+    assertThat(scene.copies).isNotEmpty();
+    BuffInstance copy = scene.copies.get(0);
+    assertThat(copy.getSpawnsLeft()).isZero();
+    assertThat(
+            ((CharacterEntity) scene.clones.get(0)).getBuffs().carries("SkeletonDuplication_EV1"))
+        .isTrue();
+    // Through the copy's time: only the Skeleton's own child, no clone made one.
+    scene.step(10);
+    assertThat(scene.spawns).hasSize(1).allMatch(spawn -> spawn.startsWith("skeleton "));
+  }
+
+  @Test
+  @DisplayName(
+      "with the duplication's row not cloned, the clone's copy is taken off as the clone is made,"
+          + " and the clone makes nothing")
+  void aNotClonedDuplicationIsTakenOffTheClone() {
+    Scene scene = clonedAfterTheFirstChild(notClonedTables);
+
+    assertThat(scene.copies).isNotEmpty();
+    for (WorldEntity clone : scene.clones) {
+      assertThat(((CharacterEntity) clone).getBuffs().carries("SkeletonDuplication_EV1")).isFalse();
+    }
+    scene.step(10);
+    assertThat(scene.spawns).hasSize(1).allMatch(spawn -> spawn.startsWith("skeleton "));
+  }
 }
