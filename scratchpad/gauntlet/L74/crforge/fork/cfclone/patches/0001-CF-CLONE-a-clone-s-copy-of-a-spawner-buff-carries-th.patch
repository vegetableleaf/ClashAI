@@ -121,6 +123,9 @@ public final class BuffInstance {
     copy.hitCounter = hitCounter;
     copy.sourceLauncherId = sourceLauncherId;
     copy.castId = castId;
+    copy.spawnTimer = spawnTimer;
+    copy.spawnWaveMade = spawnWaveMade;
+    copy.spawnsLeft = spawnsLeft;
     return copy;
   }
 
