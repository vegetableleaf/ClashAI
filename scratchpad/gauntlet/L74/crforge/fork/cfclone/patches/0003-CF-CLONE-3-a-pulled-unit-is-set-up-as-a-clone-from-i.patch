+  /**
+   * Casts a Clone for a side on a unit's point at the scene's tick and steps until the Clone has
+   * made its clones, answering their names.
+   */
+  private static List<String> cloneOn(Scene scene, CharacterEntity unit) {
+    List<String> clones = new ArrayList<>();
+    scene
+        .match
+        .getWorld()
+        .addObserver(
+            new WorldObserver() {
+              @Override
+              public void cloned(
+                  int t,
+                  CharacterEntity original,
+                  CharacterEntity clone,
+                  SpawnHost instigator,
+                  List<Integer> visits) {
+                clones.add(clone.name());
+              }
+            });
+    GridEntity view = unit.getView();
+    scene.match.placeAreaEffect(
+        scene.match.getBattle().getTick(),
+        "Clone",
+        LEVEL,
+        unit.side(),
+        view.getX(),
+        view.getY(),
+        "C");
+    while (clones.isEmpty() && scene.tick < 200) {
+      scene.step(1);
+    }
+    return clones;
+  }
+
+  @Test
+  @DisplayName(
+      "a Fisherman cloned while his hook drags him to a building leaves the pulled state for the"
+          + " clone's setup: the hook drags him no more and is let go, and he moves apart from his"
+          + " clone and walks on")
+  void aDraggedFishermanCloned() {
+    Scene scene = new Scene();
+    scene.still(0, 1, "Cannon", X, Y + IN_RING, "C");
+    ProjectileEntity hook = scene.stepToTheHook();
+    scene.step(1);
+    GridEntity f = scene.fisherman.getView();
+    assertThat(f.getState()).isEqualTo(GridEntityState.FOLLOWING_REMOVED_BUILDING);
+
+    assertThat(cloneOn(scene, scene.fisherman)).containsExactly("F_clone0");
+    assertThat(f.getState()).isEqualTo(GridEntityState.CLONE_SETUP);
+    // The move apart's step, not the drag's.
+    int before = f.getY();
+    scene.step(1);
+    assertThat(f.getY() - before).isPositive().isLessThan(Shipped.number(HOOK, "DragSelfSpeed"));
+    assertThat(hook.isReleased()).isTrue();
+    while (f.getState() == GridEntityState.CLONE_SETUP && scene.tick < 200) {
+      scene.step(1);
+    }
+    assertThat(f.getState())
+        .isNotIn(GridEntityState.FOLLOWING_REMOVED_BUILDING, GridEntityState.CLONE_SETUP);
+    assertThat(scene.fisherman.isActive(CharacterEntity.MOVEMENT_SLOT)).isTrue();
+  }
+
+  @Test
+  @DisplayName(
+      "a troop cloned while a hook pulls it leaves the pulled state for the clone's setup: it"
+          + " follows the hook no more, which flies back and is let go, and the Fisherman goes on")
+  void aPulledTroopCloned() {
+    Scene scene = new Scene();
+    CharacterEntity knight = scene.still(0, 1, "Knight", X, Y + IN_RING, "K");
+    ProjectileEntity hook = scene.stepToTheHook();
+    scene.step(1);
+    assertThat(knight.getView().getState()).isEqualTo(GridEntityState.FOLLOWING_REMOVED);
+
+    assertThat(cloneOn(scene, knight)).containsExactly("K_clone0");
+    assertThat(knight.getView().getState()).isEqualTo(GridEntityState.CLONE_SETUP);
+    while (!hook.isReleased() && scene.tick < 200) {
+      scene.step(1);
+    }
+    assertThat(hook.isReleased()).isTrue();
+    // Let go short of the Fisherman, away from the troop, which moved apart on its own.
+    assertThat(knight.getView().getY()).isGreaterThan(hook.getY());
+    scene.step(2);
+    assertThat(scene.fisherman.getView().getState())
+        .isNotEqualTo(GridEntityState.COMPONENTS_DISABLED);
+  }
+
