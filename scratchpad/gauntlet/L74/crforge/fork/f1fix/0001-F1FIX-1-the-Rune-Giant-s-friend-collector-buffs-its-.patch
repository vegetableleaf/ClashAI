 .../unit/BattleExpressionEnvironment.java     | 11 +++++
 .../core/battle/unit/BattleAbilityTest.java   | 42 ++++++++-----------
 3 files changed, 39 insertions(+), 27 deletions(-)

diff --git a/core/src/main/java/org/crforge/core/battle/data/ActionRows.java b/core/src/main/java/org/crforge/core/battle/data/ActionRows.java
index 1e9b92f8..af4940a2 100644
--- a/core/src/main/java/org/crforge/core/battle/data/ActionRows.java
+++ b/core/src/main/java/org/crforge/core/battle/data/ActionRows.java
@@ -2165,14 +2165,21 @@ public final class ActionRows {
         throw new UnsupportedOperationException(
             name + " unbuffs a friend beyond a distance, which is not modelled");
       }
+      // The shipped row names a filter row the tables do not ship (friendly_troops_for_rune_giant).
+      // The live game buffs the Rune Giant's own troops all the same (SME-F1FIX: 136 of 136 enchant
+      // projectiles in 14 live matches, data 16.402 and 16.635, went to an own troop, none to a
+      // tower), so a name the tables do not hold reads as the row they hold for the Giant Buffer
+      // and the Royal Chef, the one filter of the NO_GIANTBUFFER_CHEF_ENCHANTMENT tag.
+      GameObjectFilter filter = records.filterIfHeld(f.get("TargetFilter").asText());
+      if (filter == null) {
+        filter = records.filterIfHeld("friendly_troops_for_chef_giant_buffer");
+      }
       return new CollectFriends(
           shared,
           CollectFriends.Columns.builder()
               .cooldownMs(integer(f, "Cooldown"))
               .maxFriendlyTroops(integer(f, "MaxFriendlyTroops"))
-              // The shipped row names a filter row the tables do not ship; the loader reads it as
-              // no filter.
-              .targetFilter(records.filterIfHeld(f.get("TargetFilter").asText()))
+              .targetFilter(filter)
               .distanceToGetTargets(integer(f, "DistanceToGetTargets"))
               .distanceToBuff(integer(f, "DistanceToBuff"))
               .distanceToUnbuff(integer(f, "DistanceToUnbuff"))
