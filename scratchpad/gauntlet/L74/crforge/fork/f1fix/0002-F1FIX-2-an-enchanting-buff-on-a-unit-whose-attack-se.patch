+  @Test
+  @DisplayName(
+      "an enchanting buff on an Inferno Dragon, whose sequence is a ramp of damage, starts")
+  void anEnchantedInfernoDragonStarts() {
+    // SME-F1FIX: the live Rune Giant enchants Inferno Dragons, and 010824 is exact through it with
+    // the row's hit hooks; a sequence whose entries launch or act stays refused.
+    GameTables tables = GameData.tables();
+    BattleRecords records = GameData.records();
+    Standard1v1Battle match = new Standard1v1Battle(tables, Standard1v1Battle.DEFAULT_LEVEL, false);
+    CharacterEntity giver =
+        match.deploy(0, records.unit("Knight"), Standard1v1Battle.DEFAULT_LEVEL, 0, 3500, 9500);
+    CharacterEntity dragon =
+        match.deploy(
+            0, records.unit("InfernoDragon"), Standard1v1Battle.DEFAULT_LEVEL, 0, 3500, 12500);
+    BattleWorld world = match.getWorld();
+    BattleAction buff =
+        world.getActions().build("giantbuffer_enchanting_buff", world.binding(dragon));
+    assertThatCode(() -> dragon.actionHolder().start(buff, giver.actionHolder()))
+        .doesNotThrowAnyException();
+  }
+
