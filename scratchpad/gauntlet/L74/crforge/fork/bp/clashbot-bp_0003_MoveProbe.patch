   int endpoint(int referenceCol, int referenceRow, int radius);
 
+  /**
+   * Instrumentation only (MoveProbe): the goal node {@link #endpoint} would answer with the
+   * reference where it stood when the tick began, or -1 when that cannot be told. Nothing in the
+   * simulation calls it.
+   */
+  default int probeEndpointFromTickStart(int radius) {
+    return -1;
+  }
+
   /**
    * Moves a position off water to the nearest usable cell centre and returns it packed as {@code x
    * | (y << 16)} in game units.
diff --git a/core/src/main/java/org/crforge/core/pathfinding/move/RoutePreparation.java b/core/src/main/java/org/crforge/core/pathfinding/move/RoutePreparation.java
index 3b030d9c..62bc63e5 100644
--- a/core/src/main/java/org/crforge/core/pathfinding/move/RoutePreparation.java
+++ b/core/src/main/java/org/crforge/core/pathfinding/move/RoutePreparation.java
@@ -64,6 +64,7 @@ public final class RoutePreparation {
     int width = grid.getWidth();
     int goalCol;
     int goalRow;
+    int probeRadius = 0;
     int explicitX = component.getExplicitX();
     int explicitY = component.getExplicitY();
     if (explicitX >= 0 && explicitY >= 0) {
@@ -72,6 +73,7 @@ public final class RoutePreparation {
     } else if (reference != null) {
       chain.mark("endpoint");
       int radius = queries.attackRange();
+      probeRadius = radius;
       int packed =
           queries.endpoint(
               reference.x() / TileMap.CELL_UNITS, reference.y() / TileMap.CELL_UNITS, radius);
@@ -126,6 +128,8 @@ public final class RoutePreparation {
 
     boolean compare = !goalChanged && globals.samePathEpsilon() >= 1;
     Route saved = compare ? route.copy() : new Route();
+    int heldNext = route.size() >= 1 ? route.last() : -1;
+    int heldGoal = route.size() >= 1 ? route.get(0) : -1;
     int startCol = FixedMath.div(owner.getX(), TileMap.CELL_UNITS);
     int startRow = FixedMath.div(owner.getY(), TileMap.CELL_UNITS);
     chain.mark("search");
@@ -152,6 +156,24 @@ public final class RoutePreparation {
             grid.getCurrent(), grid.getPrevious(), saved, deduplicated)) {
       component.setRoute(saved);
     }
+    if (MoveProbe.on()) {
+      MoveProbe.tell(
+          "replan",
+          owner.getId(),
+          new int[] {
+            goalChanged ? 1 : 0,
+            component.getRoute() == saved ? 1 : 0,
+            deduplicated.size(),
+            deduplicated.size() >= 1 ? deduplicated.last() : -1,
+            deduplicated.size() >= 2 ? deduplicated.get(deduplicated.size() - 2) : -1,
+            heldNext,
+            goalRow * width + goalCol,
+            heldGoal,
+            reference == null ? -1 : reference.x(),
+            reference == null ? -1 : reference.y(),
+            reference == null ? -1 : queries.probeEndpointFromTickStart(probeRadius)
+          });
+    }
     if (reference != null) {
       chain.mark("farther");
       component.setRouteLeadsAway(queries.farther() & 1);
