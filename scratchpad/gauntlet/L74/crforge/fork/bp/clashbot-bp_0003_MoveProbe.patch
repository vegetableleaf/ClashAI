diff --git a/core/src/main/java/org/crforge/core/pathfinding/GridMovementQueries.java b/core/src/main/java/org/crforge/core/pathfinding/GridMovementQueries.java
index 222427a7..61be3e05 100644
--- a/core/src/main/java/org/crforge/core/pathfinding/GridMovementQueries.java
+++ b/core/src/main/java/org/crforge/core/pathfinding/GridMovementQueries.java
@@ -218,6 +218,37 @@ public final class GridMovementQueries implements MovementQueries {
         null);
   }
 
+  /** Instrumentation only (MoveProbe): see {@link MovementQueries#probeEndpointFromTickStart}. */
+  @Override
+  public int probeEndpointFromTickStart(int radius) {
+    TargetView target = targetingOn ? unit.targeting().getReference() : null;
+    if (target == null || target.getEntity() == null) {
+      return -1;
+    }
+    GridEntity entity = unit.entity();
+    GridEntity other = target.getEntity();
+    int px = other.getPrevX();
+    int py = other.getPrevY();
+    int packed =
+        ReferenceEndpoint.selectEndpoint(
+            grid.getWidth(),
+            grid.getHeight(),
+            entity.getX(),
+            entity.getY(),
+            px / org.crforge.core.pathfinding.grid.TileMap.CELL_UNITS,
+            py / org.crforge.core.pathfinding.grid.TileMap.CELL_UNITS,
+            radius,
+            entity.isAir(),
+            PathfindingGlobals.KS_POS_TO_TARGET_FLYING_NO_WATER,
+            PathfindingGlobals.KS_POS_TO_TARGET_GROUND_AVOID_BUILDINGS,
+            ReferenceEndpoint.everyCellInBounds(grid.getWidth(), grid.getHeight()),
+            (x, y) -> FixedMath.squaredDistance(px, py, x, y),
+            grid::water,
+            (col, row) -> CellTests.overlayBlocks(grid, col, row),
+            null);
+    return packed < 0 ? -1 : (packed & 0xffff) * grid.getWidth() + (packed >> 16);
+  }
+
   /** 1 for a hovering unit, which a push does not move off water. */
   @Override
   public int hovering() {
diff --git a/core/src/main/java/org/crforge/core/pathfinding/move/MoveProbe.java b/core/src/main/java/org/crforge/core/pathfinding/move/MoveProbe.java
new file mode 100644
index 00000000..4019e995
--- /dev/null
+++ b/core/src/main/java/org/crforge/core/pathfinding/move/MoveProbe.java
@@ -0,0 +1,52 @@
+/*
+ * crforge - https://github.com/voonhous/crforge
+ * SPDX-License-Identifier: Apache-2.0
+ * Porting this code? Please cite this file and the commit you read: see the README.
+ */
+
+package org.crforge.core.pathfinding.move;
+
+/**
+ * Instrumentation only (clashbot-bp, A2c-BP3): when {@link #CURRENT} holds a probe, it is told of
+ * each displacement a movement chain runs and of each route search route preparation runs, so a
+ * caller can see where an entity aimed inside a step. Unset (the default), nothing calls it and the
+ * battle runs as before.
+ */
+@FunctionalInterface
+public interface MoveProbe {
+
+  /** The probe in use, or null for none. */
+  MoveProbe[] CURRENT = {null};
+
+  /**
+   * One event.
+   *
+   * <ul>
+   *   <li>{@code disp}: a displacement; v = start x, start y, target x, target y, budget, reached
+   *       bit after it.
+   *   <li>{@code replan}: a ground route search; v = goal changed bit, kept the held route bit,
+   *       new route size, new route's next node, the node after it (-1 none), the held route's next
+   *       node before the search (-1 none), the goal node, the held route's goal node (-1 none), the
+   *       reference point x and y (-1 none), the goal node the reference's point at the start of
+   *       the tick would give (-1 none).
+   * </ul>
+   *
+   * @param point the event
+   * @param entityId the entity it is about
+   * @param v the event's values, as listed above
+   */
+  void at(String point, int entityId, int[] v);
+
+  /** True when a probe is in use; callers test this before building the values. */
+  static boolean on() {
+    return CURRENT[0] != null;
+  }
+
+  /** Tells the probe in use, if any. */
+  static void tell(String point, int entityId, int[] v) {
+    MoveProbe p = CURRENT[0];
+    if (p != null) {
+      p.at(point, entityId, v);
+    }
+  }
+}
diff --git a/core/src/main/java/org/crforge/core/pathfinding/move/MovementChain.java b/core/src/main/java/org/crforge/core/pathfinding/move/MovementChain.java
index 96aebd11..3890345c 100644
