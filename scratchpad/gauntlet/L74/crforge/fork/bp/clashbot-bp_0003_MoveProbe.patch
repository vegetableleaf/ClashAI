+++ b/core/src/main/java/org/crforge/core/pathfinding/move/MovementChain.java
@@ -239,6 +239,8 @@ public final class MovementChain {
    */
   public MovementOutcome displace(
       int targetX, int targetY, int budget, int updateFacing, int attackFlag) {
+    int startX = owner.getX();
+    int startY = owner.getY();
     Displacement.displace(
         component,
         owner,
@@ -252,6 +254,12 @@ public final class MovementChain {
         budget,
         updateFacing,
         attackFlag);
+    if (MoveProbe.on()) {
+      MoveProbe.tell(
+          "disp",
+          owner.getId(),
+          new int[] {startX, startY, targetX, targetY, budget, component.getWaypointReached()});
+    }
     return new MovementOutcome(owner.getX(), owner.getY(), component.getWaypointReached());
   }
 
diff --git a/core/src/main/java/org/crforge/core/pathfinding/move/MovementQueries.java b/core/src/main/java/org/crforge/core/pathfinding/move/MovementQueries.java
index 2dc722e1..7b2bdfb9 100644
