 .../core/pathfinding/move/MoveProbe.java      | 52 +++++++++++++++++++
 .../core/pathfinding/move/MovementChain.java  |  8 +++
 .../pathfinding/move/MovementQueries.java     |  9 ++++
 .../pathfinding/move/RoutePreparation.java    | 22 ++++++++
 5 files changed, 122 insertions(+)
