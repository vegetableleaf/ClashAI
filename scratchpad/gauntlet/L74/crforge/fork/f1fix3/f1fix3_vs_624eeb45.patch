+package org.crforge.core.battle.unit;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatCode;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+import com.fasterxml.jackson.databind.JsonNode;
+import com.fasterxml.jackson.databind.node.ArrayNode;
+import com.fasterxml.jackson.databind.node.ObjectNode;
+import java.io.IOException;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.List;
+import org.crforge.core.battle.GameData;
+import org.crforge.core.battle.action.ActionInstance;
+import org.crforge.core.battle.action.BattleAction;
+import org.crforge.core.battle.action.GiantBufferBuff;
+import org.crforge.core.battle.data.BattleRecords;
+import org.crforge.core.battle.data.GameTables;
+import org.crforge.core.battle.projectile.ProjectileEntity;
+import org.junit.jupiter.api.DisplayName;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+
+/**
+ * What the Rune Giant's enchanting buff does on the units whose attack sequence it used to refuse
+ * (SME-F1FIX-3): the third landed hit carries the added damage, as it does on a unit with no
+ * sequence, and the others do not.
+ */
+class BattleRuneGiantEnchantTest {
+
+  private static final int LEVEL = Standard1v1Battle.DEFAULT_LEVEL;
+
+  private static final int X = 9000;
+
+  private static final int Y = 12000;
+
+  /** One unit standing still next to a Giant, with or without the buff on it. */
+  private static final class Scene {
+    final Standard1v1Battle match;
+    final CharacterEntity unit;
+    final CharacterEntity giver;
+    final CharacterEntity target;
+    final List<Integer> hits = new ArrayList<>();
+
+    Scene(String row, int targetDistance) {
+      this(GameData.tables(), row, targetDistance);
+    }
+
+    Scene(GameTables tables, String row, int targetDistance) {
+      match = new Standard1v1Battle(tables, LEVEL, false);
+      giver = still(0, "Knight", X, Y - 3000);
+      target = still(1, "Golem", X, Y + targetDistance);
+      if (match.getWorld().getRecords().unit(row).spawnAttach()) {
+        // A unit that makes its riders is made by its card.
+        String card = row.equals("Ram") ? "RamRider" : row;
+        match.play(2, match.getWorld().getRecords().card(card), LEVEL, 0, X, Y, "Blue");
+        for (int i = 0; i < 4; i++) {
+          match.getBattle().step();
+        }
+        unit =
+            match.getWorld().present().stream()
+                .filter(e -> e.getData().name().equals(row))
+                .map(CharacterEntity.class::cast)
+                .findFirst()
+                .orElseThrow();
+        unit.setActive(CharacterEntity.MOVEMENT_SLOT, false);
+      } else {
+        unit = still(0, row, X, Y);
+      }
+    }
+
+    CharacterEntity still(int side, String row, int x, int y) {
+      CharacterEntity made =
+          match.deploy(0, match.getWorld().getRecords().unit(row), LEVEL, side, x, y, row);
+      made.setActive(CharacterEntity.MOVEMENT_SLOT, false);
+      return made;
+    }
+
+    void enchant() {
+      BattleWorld world = match.getWorld();
+      BattleAction buff =
+          world.getActions().build("giantbuffer_enchanting_buff", world.binding(unit));
+      unit.actionHolder().start(buff, giver.actionHolder());
+    }
+
+    void step(int ticks) {
+      for (int i = 0; i < ticks; i++) {
+        int before = target.getHitPoints().getHitPoints();
+        match.getBattle().step();
+        int lost = before - target.getHitPoints().getHitPoints();
+        if (lost > 0) {
+          hits.add(lost);
+        }
+      }
+    }
+  }
+
+  private static List<Integer> hits(String row, int distance, boolean enchanted, int ticks) {
+    Scene scene = new Scene(row, distance);
+    // The unit's own starting actions run as it deploys, before the buff lands on it.
+    scene.step(2);
+    assertThat(scene.hits).as("hits before the buff").isEmpty();
+    if (enchanted) {
+      scene.enchant();
+    }
+    scene.step(ticks);
+    return scene.hits;
+  }
+
+  @ParameterizedTest
+  @ValueSource(
+      strings = {
+        "LittlePrince",
+        "AngryBarbarian_EV1",
+        "AngryBarbarian_EV1_2",
+        "BowlerHero",
+        "EliteArcherHero",
+        "Musketeer_EV1",
+        "Archer_EV1",
+        "Princess_EV1",
+        "Berserker",
+      })
+  @DisplayName("every third landed hit of a unit with an attack sequence carries the added damage")
+  void everyThirdHitIsEnchanted(String row) {
+    // The evolved Angry Barbarians' first entry and the Berserker's are melee hits, so the target
+    // stands next to them.
+    int distance = row.startsWith("AngryBarbarian") || row.equals("Berserker") ? 1200 : 2500;
+    List<Integer> plain = hits(row, distance, false, 600);
+    List<Integer> enchanted = hits(row, distance, true, 600);
+    assertThat(plain).hasSizeGreaterThanOrEqualTo(6);
+    // The last hit may be the one that kills the target, which cuts it short.
+    int n = Math.min(plain.size(), enchanted.size()) - 1;
+    for (int i = 0; i < n; i++) {
+      if (i % 3 == 2) {
+        assertThat(enchanted.get(i)).as(row + " hit " + i).isGreaterThan(plain.get(i));
+      } else {
+        assertThat(enchanted.get(i)).as(row + " hit " + i).isEqualTo(plain.get(i));
+      }
+    }
+  }
+
+  @ParameterizedTest
+  @ValueSource(strings = {"Ram", "GoblinGiant", "GoblinGiant_EV1"})
+  @DisplayName(
+      "a unit whose riders hit through rows the buff gives a multiplier of 0 is enchanted without"
+          + " copies for them")
+  void aUnitWithRidersIsEnchanted(String row) {
+    Scene scene = new Scene(row, 1200);
+    scene.step(2);
+    assertThatCode(scene::enchant).doesNotThrowAnyException();
+    assertThatCode(() -> scene.step(200)).doesNotThrowAnyException();
+  }
+
+  @Test
+  @DisplayName("a unit whose riders hit through a row the buff does not zero is refused")
+  void ridersThroughAnUnzeroedRowAreRefused(@TempDir Path folder) throws IOException {
+    GameTables tables =
+        GameData.altered(
+            folder,
+            "actions",
+            rows -> {
+              ObjectNode fields =
+                  (ObjectNode) rows.get("giantbuffer_enchanting_buff").get("fields");
+              JsonNode names = fields.get("DamageMultiplierPerUnitNames");
+              ArrayNode values = (ArrayNode) fields.get("DamageMultiplierPerUnitValues");
+              for (int i = 0; i < names.size(); i++) {
+                if (names.get(i).asText().equals("RamRiderBola")) {
+                  values.set(i, values.numberNode(1000));
+                }
+              }
+            });
+    Scene scene = new Scene(tables, "Ram", 1200);
+    scene.step(2);
+    assertThatThrownBy(scene::enchant)
+        .isInstanceOf(UnsupportedOperationException.class)
+        .hasMessageContaining("attached children get copies that add damage through RamRiderBola");
+  }
+
+  @Test
+  @DisplayName("a Berserker whose attack sequence entries differ is refused at its second attack")
+  void aBerserkerWithDifferentEntriesIsRefused(@TempDir Path folder) throws IOException {
+    GameTables tables =
+        GameData.altered(
+            folder,
+            "characters",
+            rows -> {
+              ObjectNode columns = (ObjectNode) rows.get("Berserker").get("columns");
+              ((ObjectNode) columns.get("AttackSequenceList").get(1)).put("Damage", 41);
+            });
+    Scene scene = new Scene(tables, "Berserker", 1200);
+    scene.step(2);
+    scene.enchant();
+    assertThatThrownBy(() -> scene.step(200))
+        .hasMessageContaining("sets the Berserker's attack sequence step");
+  }
+
+  @Test
+  @DisplayName(
+      "an enchant that lands after the Rune Giant that threw it has gone ends its run at once")
+  void anEnchantFromAGoneRuneGiantEndsAtOnce() {
+    Standard1v1Battle match = new Standard1v1Battle(GameData.tables(), LEVEL, false);
+    BattleRecords records = match.getWorld().getRecords();
+    CharacterEntity friend = match.deploy(0, records.unit("Knight"), LEVEL, 0, 3500, 12500);
+    CharacterEntity giant = match.deploy(0, records.unit("GiantBuffer"), LEVEL, 0, 3500, 9500);
+    List<ProjectileEntity> thrown = new ArrayList<>();
+    match
+        .getWorld()
+        .addObserver(
+            new WorldObserver() {
+              @Override
+              public void projectileLaunched(int t, ProjectileEntity projectile) {
+                if (projectile.getData().name().equals("GiantBuffProjectile")) {
+                  thrown.add(projectile);
+                }
+              }
+            });
+    for (int step = 0; step < 200 && thrown.isEmpty(); step++) {
+      match.getBattle().step();
+    }
+    assertThat(thrown).as("the enchant was thrown").isNotEmpty();
+    // The Giant falls with its enchant in the air.
+    match.getWorld().kill(giant, null);
+    boolean ran = false;
+    for (int step = 0; step < 100; step++) {
+      match.getBattle().step();
+      for (ActionInstance instance : friend.actionHolder().running()) {
+        ran |= instance instanceof GiantBufferBuff.Run && !instance.isFinished();
+      }
+    }
+    assertThat(ran).as("a run on the friend after its Giant had gone").isFalse();
+  }
+}
