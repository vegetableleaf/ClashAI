+  @Override
+  public boolean actionAttackSequenceUniform() {
+    return data.attackSequence().entries().stream().distinct().count() <= 1;
+  }
+
+  @Override
+  public int actionMinAttackIntervalMs() {
+    int pace = 100;
+    for (AttackSequence.Entry entry : data.attackSequence().entries()) {
+      pace = Math.max(pace, entry.hitSpeedMultiplier());
+    }
+    return (int) ((long) data.hitSpeedMs() * 100 / pace);
+  }
+
+  @Override
+  public List<String> actionAttachedDamageRows() {
+    if (!data.spawnAttach()) {
+      return List.of();
+    }
+    UnitData child = world.getRecords().unit(data.spawnCharacter());
+    List<String> rows = new ArrayList<>();
+    List<ProjectileData> projectiles = new ArrayList<>();
+    projectiles.add(child.projectile());
+    projectiles.add(child.customFirstProjectile());
+    projectiles.add(child.projectileSpecial());
+    boolean direct = child.damage() > 0 || child.damageSpecial() > 0;
+    for (AttackSequence.Entry entry : child.attackSequence().entries()) {
+      projectiles.add(entry.projectile());
+      projectiles.add(entry.customFirstProjectile());
+      direct |= entry.damage() > 0 || entry.doAttackAction() != null;
+    }
+    boolean launches = false;
+    for (ProjectileData projectile : projectiles) {
+      if (projectile != null) {
+        launches = true;
+        if (!rows.contains(projectile.name())) {
+          rows.add(projectile.name());
+        }
+      }
+    }
+    if (direct && !launches) {
+      rows.add(child.name());
+    }
+    return rows;
   }
 
