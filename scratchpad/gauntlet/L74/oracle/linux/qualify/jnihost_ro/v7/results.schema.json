{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ORACLE v7 private staged attempt result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "token",
    "runtime_version",
    "policy",
    "status",
    "events",
    "last_completed",
    "failure_stage",
    "returncode",
    "timeout",
    "host_error",
    "isolation_before",
    "isolation_after",
    "identity",
    "receipts",
    "limitation",
    "stage_limit",
    "calls"
  ],
  "properties": {
    "schema_version": {
      "const": 7
    },
    "token": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "runtime_version": {
      "const": "160402012"
    },
    "policy": {
      "const": {
        "client_launched": false,
        "bridge_writes": 0,
        "code_patches": 0,
        "environment_spoofing": false,
        "unpacking": false,
        "patches_qualified": 0
      }
    },
    "status": {
      "enum": [
        "blocked",
        "collected"
      ]
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "token",
          "pid",
          "stage",
          "event",
          "value",
          "monotonic_ns",
          "elapsed_ns"
        ],
        "properties": {
          "schema_version": {
            "const": 7
          },
          "token": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "pid": {
            "type": "integer",
            "minimum": 1
          },
          "stage": {
            "enum": [
              "class_loader",
              "observer_load",
              "dependency_preload",
              "jni_on_load",
              "create_game_main",
              "game_main_init",
              "data_tables_range",
              "data_load_tasks",
              "loading_state",
              "map_resources",
              "battlefield_cache",
              "manager_update",
              "stop_after_stage_limit"
            ]
          },
          "event": {
            "enum": [
              "before",
              "after",
              "observation",
              "observation_before",
              "observation_failure",
              "native_return",
              "arguments",
              "boundary",
              "error"
            ]
          },
          "value": {
            "type": [
              "null",
              "string",
              "object",
              "integer"
            ]
          },
          "monotonic_ns": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "elapsed_ns": {
            "type": "string",
            "pattern": "^[0-9]+$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "event": {
                  "enum": [
                    "observation",
                    "observation_before",
                    "observation_failure"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "$ref": "#/$defs/observation"
                }
              }
            }
          }
        ]
      }
    },
    "last_completed": {
      "type": [
        "string",
        "null"
      ]
    },
    "failure_stage": {
      "type": [
        "string",
        "null"
      ]
    },
    "returncode": {
      "type": [
        "integer",
        "null"
      ]
    },
    "timeout": {
      "type": "boolean"
    },
    "host_error": {
      "type": [
        "string",
        "null"
      ]
    },
    "isolation_before": {
      "type": [
        "object",
        "null"
      ]
    },
    "isolation_after": {
      "type": [
        "object",
        "null"
      ]
    },
    "identity": {
      "type": [
        "object",
        "null"
      ]
    },
    "receipts": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "host_output": {
      "type": "object",
      "required": [
        "stdout",
        "stderr"
      ],
      "additionalProperties": false,
      "properties": {
        "stdout": {
          "type": "string"
        },
        "stderr": {
          "type": "string"
        }
      }
    },
    "limitation": {
      "type": "string"
    },
    "stage_limit": {
      "enum": [
        "load-only",
        "create_game_main",
        "game_main_init",
        "data_tables_range",
        "data_load_tasks",
        "loading_state",
        "map_resources",
        "battlefield_cache",
        "manager_update"
      ]
    },
    "calls": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "collection_duration_ns": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]+$"
    }
  },
  "$defs": {
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module_base",
        "jni_delta",
        "game_main",
        "game_main_status",
        "atomic",
        "context",
        "manager",
        "loading_state",
        "loading_phase",
        "task",
        "tables",
        "tables_ready",
        "task_phase",
        "resource_count",
        "tables_from_saved_receiver",
        "location",
        "primary_payload",
        "secondary_payload",
        "cache",
        "battlefield",
        "instance_id"
      ],
      "properties": {
        "module_base": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "jni_delta": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "game_main": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[1-9][0-9]*$"
        },
        "game_main_status": {
          "enum": [
            "unreadable",
            "absent",
            "identified",
            "unverified_pointer"
          ]
        },
        "atomic": {
          "const": false
        },
        "context": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "manager": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "loading_state": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "task": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "tables": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "loading_phase": {
          "type": [
            "integer",
            "null"
          ]
        },
        "task_phase": {
          "type": [
            "integer",
            "null"
          ]
        },
        "resource_count": {
          "type": [
            "integer",
            "null"
          ]
        },
        "tables_ready": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "tables_from_saved_receiver": {
          "type": "boolean"
        },
        "location": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "primary_payload": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "secondary_payload": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "cache": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "battlefield": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "instance_id": {
          "type": "integer"
        }
      }
    }
  }
}
