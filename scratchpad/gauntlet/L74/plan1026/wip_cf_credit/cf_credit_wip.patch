+def cf_append(B: dict, results: list[dict], use: list, keep: list, W: list) -> int:
+    """cf_credit (in place): one row per cf alternative of every kept match, appended AFTER all real rows of ``B``: the
+    decision's own inputs (its traj row ``row``) with the alternative's action (played, slot, cell) and behaviour log-probs,
+    A = the raw DeltaQ (``gae_batch`` turns it into cf_w x clip(DeltaQ / sd, +-cf_clip)), the match's row weight, no reward
+    / discount / Phi / posture / press term; ``B["cf"]`` = False on the real rows, True on these. Every row-aligned key of B
+    must have a rule (a new batch key fails loudly here instead of riding along wrong). -> rows added."""
+    n = len(B["A"])
+    cfm = np.zeros(n, dtype=bool)
+    add: dict = {k: [] for k in B if not k.startswith("mem_tab_")}
+    for j in use:
+        t = results[j]["traj"]
+        for smp in (results[j].get("cf") or {}).get("samples", []):
+            di = int(smp["row"])
+            if di >= len(keep[j]) or not keep[j][di]:
+                continue                                      # (never: a trigger decision always samples its gate)
+            for a in smp["alts"]:
+                over = {"played": bool(a["play"]), "slot": int(a["slot"]), "cell": int(a["cell"]),
+                        "lp_gate": a["lp_gate"], "lp_card": a["lp_card"], "lp_cell": a["lp_cell"],
+                        "lp_old": a["lp_gate"] + a["lp_card"] + a["lp_cell"], "A": float(a["dq"]), "w": W[j][0],
+                        "match": j, "mem_row_tab": use.index(j), "r_step": 0.0, "gamma_row": 1.0, "phi": 0.0,
+                        "w_post": 0.0, "w_ab": 0.0, "ab_sampled": False, "ab_press": False, "ab_lp": 0.0,
+                        "posture_new": False, "posture_lp": 0.0}
+                if "mem_row_t" in add:
+                    over["mem_row_t"] = t["mem_t"][di]
+                for k in add:
+                    if k in over:
+                        add[k].append(over[k])
+                    elif k in t:
+                        add[k].append(t[k][di])
+                    else:
+                        raise ValueError(f"cf_credit: no rule for batch key {k!r} on an alternative row")
+    m = len(add["A"]) if add else 0
+    for k, v in add.items():
+        if m:
+            B[k] = np.concatenate([B[k], np.asarray(v, dtype=B[k].dtype).reshape((m,) + B[k].shape[1:])])
+    B["cf"] = np.concatenate([cfm, np.ones(m, dtype=bool)])
+    return m
+
