+//! match.TIEBREAK_REGEN = client16402_stops_after_end: past a level overtime's end under the client's drain the elixir
+//! regen stops; the last step is the one into t6003 (end + TIEBREAK_REGEN_STOP_MS).
+//!
+//! THE READING (ClashBot's client 16.402 live frame logs): the own bar read 3.0096 on t6001 and 3.117 on t6003, t6005,
+//! t6007 ... (20261018_020557); 6.6057 on t6001 and 6.7131 on t6004 and t6005 (20261017_061258).
+//!
+//! The scene: a battle with no play put on t5990 (level towers: overtime runs to its end), both bars emptied; the steps
+//! into t5995..t6010.
+//!
+//! PLANT (regression): tiebreak_regen_runs -> `the_regen_stops_after_the_step_into_6003` red.
+//!   RUSTFLAGS='--cfg clash_plant="tiebreak_regen_runs"' CARGO_TARGET_DIR=target/plant cargo test --profile gate --test
+//!   tiebreak_regen
+#![allow(unexpected_cfgs)]
+mod common;
+
+use common::*;
+use royalesim::state::{BattleState, Calib, TiebreakRegen};
+use royalesim::Team;
+
+fn steps(arm: TiebreakRegen) -> Vec<(u32, i64)> {
+    let mut cfg = config();
+    cfg.calib.tiebreak_regen = arm;
+    let mut s = BattleState::try_new(0, cfg).expect("the default battle");
+    s.scenario_set_tick(5990);
+    s.scenario_set_elixir_milli(Team::Blue, 0);
+    let mut out = Vec::new();
+    while s.tick_count() < 6010 {
+        let before = s.elixir_raw(Team::Blue).0;
+        s.tick();
+        out.push((s.tick_count(), s.elixir_raw(Team::Blue).0 - before));
+    }
+    out
+}
+
+/// Plant: tiebreak_regen_runs.
+#[test]
+fn the_regen_stops_after_the_step_into_6003() {
+    let new = steps(Calib::shipped().tiebreak_regen);
+    for &(t, d) in &new {
+        assert_eq!(d > 0, t <= 6003, "the step into t{t}: {d} ({new:?})");
+    }
+    // NOT VACUOUS: the old arm regenerates on.
+    assert!(steps(TiebreakRegen::Runs).iter().all(|&(_, d)| d > 0), "the old arm stopped too");
+}
+
+#[test]
+fn the_shipped_arm_stops_the_regen() {
+    assert_eq!(Calib::shipped().tiebreak_regen, TiebreakRegen::Client16402StopsAfterEnd);
+}
