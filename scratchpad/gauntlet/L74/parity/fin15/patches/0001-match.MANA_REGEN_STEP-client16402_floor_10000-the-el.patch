+        // match.MANA_REGEN_STEP = exact_lcm (the old arm): from START_MANA, (MAX-START) elixir at 1x takes exactly this many
+        // ticks. The shipped client16402_floor_10000 floors each step (178 of 10000) and fills one tick later.
         let c = Calib::shipped();
-        // From START_MANA, (MAX-START) elixir at 1x takes exactly this many ticks.
         let ms = (c.max_mana - c.start_mana) as i64 * c.mana_regen_ms_1x as i64 / c.max_mana as i64;
         let ticks = ms / c.tick_ms as i64;
-        for _ in 0..ticks - 1 {
+        for (arm, fill) in [(ManaRegenStep::ExactLcm, ticks), (ManaRegenStep::Client16402Floor10000, ticks + 1)] {
+            let mut cfg = BattleConfig::with_cards(CardDb::fallback());
+            cfg.calib.mana_regen_step = arm;
+            let mut s = BattleState::new(1, cfg);
+            for _ in 0..fill - 1 {
+                s.tick();
+            }
+            assert_eq!(s.elixir(Team::Blue), c.max_mana - 1, "{arm:?}");
             s.tick();
+            assert_eq!(s.elixir(Team::Blue), c.max_mana, "{arm:?}");
         }
-        assert_eq!(s.elixir(Team::Blue), c.max_mana - 1);
-        s.tick();
-        assert_eq!(s.elixir(Team::Blue), c.max_mana);
     }
 
     #[test]
