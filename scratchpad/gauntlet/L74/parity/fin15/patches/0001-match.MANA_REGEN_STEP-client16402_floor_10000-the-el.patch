-        let per_tick = |regen: i64| (c.tick_ms as i64) * (c.max_mana as i64) * (mana_unit / regen);
+        // match.MANA_REGEN_STEP. exact_lcm: one elixir = lcm(regen_1x, regen_2x) units, so both rates are exact
+        // integers per tick. client16402_floor_10000 (shipped): the game's unit, 1/10000 elixir, and each tick adds the
+        // whole part of the step (178 / 357; the third rate in `phase_upkeep` floors the same way). PLANT (regression)
+        // mana_regen_exact: the shipped arm accrues the exact rate.
+        #[cfg(not(clash_plant = "mana_regen_exact"))]
+        let floor = c.mana_regen_step == ManaRegenStep::Client16402Floor10000;
+        #[cfg(clash_plant = "mana_regen_exact")]
+        let floor = false;
+        let mana_unit = if floor { 10_000 } else { r1 / gcd(r1, r2) * r2 };
+        let per_tick = |regen: i64| (c.tick_ms as i64) * (c.max_mana as i64) * mana_unit / regen;
         let mana_rate = [per_tick(r1), per_tick(r2)];
 
         let mut rng = Rng::new(seed);
@@ -39762,6 +39792,8 @@ fn migrate_v3(v: &mut Value, cards: &CardDb) -> Result<Vec<u16>, String> {
     sh.insert("idle_buff_retarget".into(), serde_json::to_value(IdleBuffRetarget::IdleReturns).map_err(|e| e.to_string())?);
     // status.BUFF_PULSE_REDUCTION: a format-3 battle's pulses took the reduction once (the old arm).
     sh.insert("buff_pulse_reduction".into(), serde_json::to_value(BuffPulseReduction::Once).map_err(|e| e.to_string())?);
+    // match.MANA_REGEN_STEP: a format-3 battle's elixir was the exact lcm unit (the old arm; its snapshot keeps its unit).
