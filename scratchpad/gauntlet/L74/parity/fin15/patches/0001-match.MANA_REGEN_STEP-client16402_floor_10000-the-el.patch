             production_rate: pick(&v, &["economy", "PRODUCTION_RATE_IN_DOUBLE_ELIXIR", "value"], ProductionRate::from_calibration_name)?,
@@ -14672,10 +14696,16 @@ impl BattleState {
         let c = &config.calib;
