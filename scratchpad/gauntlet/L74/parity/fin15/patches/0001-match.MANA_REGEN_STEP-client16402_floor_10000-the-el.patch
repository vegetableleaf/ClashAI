@@ -0,0 +1,69 @@
+//! match.MANA_REGEN_STEP: the elixir unit is the game's 1/10000 and each regen tick adds the whole part of the step.
+//!
+//! THE READING (client 16.402): truth.elixir_raw of the replay corpus rises 178 a tick at 1x (59,276 of 59,318 pairs),
+//! 357 at 2x (6,278 of 6,283) and 537 at 3x (255 of 255); ClashBot's live frame logs read 0.0178 / 0.0357 / 0.0537 a tick.
+//! The exact rate (500 of 28000 a tick = 178.571 of 10000) ran 0.32 % fast at 1x.
+//!
+//! The scene: a battle with no play from 6 elixir. Pinned: the 1x and 2x steps in the game's unit on every tick, and
+//! the tick the bar first reads 10 (the game's 225, the exact rate's 224).
+//!
+//! PLANT (regression): mana_regen_exact -> `the_regen_steps_whole_ten_thousandths` red.
+//!   RUSTFLAGS='--cfg clash_plant="mana_regen_exact"' CARGO_TARGET_DIR=target/plant cargo test --profile gate
+//!   --test mana_regen_step
+mod common;
+
+use common::*;
+use royalesim::state::{BattleState, Calib, ManaRegenStep};
+use royalesim::Team;
+
+/// The step into each tick of [from, to], in the game's 1/10000 elixir, times 1000 (exact for either unit).
+fn steps(arm: ManaRegenStep, from: u32, to: u32) -> Vec<i64> {
+    let mut cfg = config();
+    cfg.calib.mana_regen_step = arm;
+    let mut s = BattleState::try_new(0, cfg).expect("the default battle");
+    let raw = |s: &BattleState| {
+        let (m, unit) = s.elixir_raw(Team::Blue);
+        m * 10_000_000 / unit
+    };
+    while s.tick_count() + 1 < from {
+        s.tick();
+    }
+    let mut out = Vec::new();
+    while s.tick_count() < to {
+        s.scenario_set_elixir_milli(Team::Blue, 0);
+        let before = raw(&s);
+        s.tick();
+        out.push(raw(&s) - before);
+    }
+    out
+}
+
+/// The first tick the bar reads 10 from the start (6 elixir, no play).
+fn full_at(arm: ManaRegenStep) -> u32 {
+    let mut cfg = config();
+    cfg.calib.mana_regen_step = arm;
+    let mut s = BattleState::try_new(0, cfg).expect("the default battle");
+    while s.elixir(Team::Blue) < 10 {
+        s.tick();
+        assert!(s.tick_count() < 400, "the bar never filled");
+    }
+    s.tick_count()
+}
+
+/// Plant: mana_regen_exact.
+#[test]
+fn the_regen_steps_whole_ten_thousandths() {
+    let shipped = Calib::shipped().mana_regen_step;
+    assert!(steps(shipped, 10, 60).iter().all(|d| *d == 178_000), "1x: {:?}", steps(shipped, 10, 60));
+    assert!(steps(shipped, 2405, 2440).iter().all(|d| *d == 357_000), "2x: {:?}", steps(shipped, 2405, 2440));
+    // NOT VACUOUS: the old arm steps the exact rational (178.571 / 357.143).
+    assert!(steps(ManaRegenStep::ExactLcm, 10, 60).iter().all(|d| *d == 178_571), "exact 1x");
+    assert!(steps(ManaRegenStep::ExactLcm, 2405, 2440).iter().all(|d| *d == 357_142), "exact 2x");
+    assert_eq!(full_at(shipped), 225, "the game fills 6 -> 10 on tick 225");
+    assert_eq!(full_at(ManaRegenStep::ExactLcm), 224, "the exact rate fills on tick 224");
+}
+
+#[test]
+fn the_shipped_arm_is_the_games_unit() {
+    assert_eq!(Calib::shipped().mana_regen_step, ManaRegenStep::Client16402Floor10000);
+}
