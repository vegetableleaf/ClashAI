+//! collision.ATTRACT_CONTACT_MEAN = client16402_in_mean_uncapped: a pulled unit's contact mean that holds the pull is not
+//! cut to 150.
+//!
+//! THE READING (client 16.402 live frames, ClashBot parity fin15 j2diag): Royal Hogs (Speed 120: a 432 pull) in contact
+//! under a Tornado close on its centre at 115-143 a tick against their walk, where the capped mean holds them at ~30
+//! (20261017_040555 t1304-t1320).
+//!
+//! The scene (tests/attract_contact_mean.rs's, with Hog Riders: a 432 pull where the Knight's 216 never meets the cap): a
+//! Blue Hog Rider on (9000, 9000), a second held at (9000, 10300), a Red Tornado 900 north of the first on its fourth tick.
+//! The first one's step per tick under the capped and the uncapped arm: they agree until the two touch, and from then the
+//! uncapped step goes further north (toward the Tornado).
+//!
+//! PLANT (regression): attract_mean_capped -> `a_mean_holding_a_pull_is_not_capped` red.
+//!   RUSTFLAGS='--cfg clash_plant="attract_mean_capped"' CARGO_TARGET_DIR=target/plant cargo test --profile gate --test
+//!   attract_mean_uncapped
+#![allow(unexpected_cfgs)]
+mod common;
+
+use common::*;
+use royalesim::fixed::{Vec2, SUBTILE_PER_MILLITILE as K};
+use royalesim::state::{AttractContactMean, BattleConfig, BattleState, Calib};
+use royalesim::Team;
+
+fn at(p: (i32, i32)) -> Vec2 {
+    Vec2::new(p.0 * K, p.1 * K)
+}
+
+const HELD_AT: (i32, i32) = (9000, 10300);
+
+fn steps(arm: AttractContactMean) -> Vec<(i32, i32)> {
+    let mut cfg: BattleConfig = config();
+    cfg.calib.attract_contact_mean = arm;
+    let mut s = BattleState::new(0, cfg);
+    let hog = s.scenario_spawn_now(Team::Blue, "HogRider", at((9000, 9000)), None).expect("the Hog Rider");
+    let held = s.scenario_spawn_now(Team::Blue, "HogRider", at(HELD_AT), None).expect("the held Hog Rider");
+    for _ in 0..3 {
+        assert!(s.debug_set_pos(held, at(HELD_AT)));
+        s.tick();
+    }
+    let p = s.entity(hog).expect("the Hog Rider").pos;
+    s.spawn_unit(Team::Red, "Tornado", Vec2::new(p.x, p.y + 900 * K), None).expect("cast the Tornado");
+    let mut out = Vec::new();
+    for _ in 0..24 {
+        assert!(s.debug_set_pos(held, at(HELD_AT)));
+        let a = s.entity(hog).expect("the scene drifted: the Hog Rider died").pos;
+        s.tick();
+        let b = s.entity(hog).expect("the scene drifted: the Hog Rider died").pos;
+        out.push((b.x / K - a.x / K, b.y / K - a.y / K));
+    }
+    out
+}
+
+/// Plant: attract_mean_capped.
+#[test]
+fn a_mean_holding_a_pull_is_not_capped() {
+    let capped = steps(AttractContactMean::Client15535InMean);
+    let uncapped = steps(AttractContactMean::Client16402InMeanUncapped);
+    let part = (0..capped.len()).find(|&k| capped[k] != uncapped[k]).expect("NOT VACUOUS: the arms never part (no capped mean)");
+    assert!(uncapped[part].1 > capped[part].1, "client16402_in_mean_uncapped: the first parted step is not further north ({:?} vs {:?})", uncapped[part], capped[part]);
+}
+
+#[test]
+fn the_shipped_arm_is_the_uncapped_mean() {
+    assert_eq!(Calib::shipped().attract_contact_mean, AttractContactMean::Client16402InMeanUncapped);
+}
