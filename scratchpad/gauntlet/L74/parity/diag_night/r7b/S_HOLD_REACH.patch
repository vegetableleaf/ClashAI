+//! targeting.HIDDEN_HOLD_REACH: a projectile attacker holding a Tesla that goes under keeps it past its keep reach
+//! (target.rs `hold_any_reach`, read by `decide` under hide.HELD_THROUGH_HIDE).
+//!
+//! Measured on client 16.402 (ClashBot parity diag_night/r7b holdcen.py, 266 captured frame logs): projectile holders out of
+//! reach let a Tesla under go 12-20 ticks after its first frame under (15 of 16), never within 3 ticks.
+//!
+//! The scene (tests/hide.rs's Giant scene with a Royal Giant): a Blue Tesla up on a Red Knight beside it, a Red Royal Giant
+//! held 7000 below it (it takes the Tesla, its nearest building, past its 5000 Range and out of the Tesla's wake reach), the
+//! Knight killed; per tick after the kill, (the Tesla under, the Royal Giant's target is the Tesla).
+//!
+//! PLANTS (`RUSTFLAGS='--cfg clash_plant="NAME"' CARGO_TARGET_DIR=target/plant cargo test --profile gate --test
+//! hidden_hold_reach`): hold_reach_dropped -> `under_any_reach_a_royal_giant_past_its_reach_keeps_a_tesla_for_its_hide_time` red.
+#![allow(unexpected_cfgs)]
+mod common;
+
+use common::*;
+use royalesim::entity::HideState;
+use royalesim::fixed::{Vec2, SUBTILE};
+use royalesim::state::{BattleState, HeldThroughHide, HiddenHoldReach};
+use royalesim::Team;
+
+fn royal_giant_on_a_hiding_tesla(arm: HiddenHoldReach, n: usize) -> Vec<(bool, bool)> {
+    let mut cfg = config();
+    cfg.calib.hide_held_through = HeldThroughHide::Client16402KeptHideTime;
+    cfg.calib.hidden_hold_reach = arm;
+    let mut s = BattleState::new(7, cfg);
+    let at = Vec2::new(9 * SUBTILE, 12 * SUBTILE);
+    let tesla = s.scenario_spawn_now(Team::Blue, "Tesla", at, None).expect("the Tesla");
+    let knight = s.scenario_spawn_now(Team::Red, "Knight", Vec2::new(9 * SUBTILE, 14 * SUBTILE), None).expect("the Knight");
+    let rg_at = Vec2::new(9 * SUBTILE, 19 * SUBTILE);
+    let rg = s.scenario_spawn_now(Team::Red, "RoyalGiant", rg_at, None).expect("the Royal Giant");
+    for _ in 0..40 {
+        assert!(s.debug_set_pos(rg, rg_at));
+        s.tick();
+    }
+    assert_eq!(s.entity(tesla).expect("the Tesla").hide_state, HideState::Up, "precondition: the Tesla is up on the Knight");
+    assert_eq!(s.entity(rg).expect("the Royal Giant").target, Some(tesla), "precondition: the Royal Giant holds the Tesla");
+    assert!(s.debug_set_hp(knight, 0));
+    (0..n)
+        .map(|_| {
+            assert!(s.debug_set_pos(rg, rg_at));
+            s.tick();
+            (s.entity(tesla).expect("the Tesla").hide_state == HideState::Hidden, s.entity(rg).expect("the Royal Giant").target == Some(tesla))
+        })
+        .collect()
+}
+
+/// client16402_any_reach: the Royal Giant past its reach keeps the Tesla for its HideTimeMs under ground (the tick it went
+/// under and 15 more, as the Giant does under hide.HELD_THROUGH_HIDE = client16402_kept_hide_time), then lets it go.
+/// Plant: hold_reach_dropped.
+#[test]
+fn under_any_reach_a_royal_giant_past_its_reach_keeps_a_tesla_for_its_hide_time() {
+    let r = royal_giant_on_a_hiding_tesla(HiddenHoldReach::Client16402AnyReach, 60);
+    let first = r.iter().position(|x| x.0).expect("precondition: the Tesla went under");
+    let held = r[first..].iter().take_while(|x| x.0 && x.1).count();
+    assert_eq!(held, 16, "client16402_any_reach: held {held} ticks under, want 16: {r:?}");
+    assert!(r[first + held].0 && !r[first + held].1, "the Tesla still under and let go on its 17th tick: {r:?}");
+}
+
+/// projectile_keep_reach (the vacuity check): past its reach the Royal Giant lets the Tesla go on its first tick under.
+#[test]
+fn under_projectile_keep_reach_a_royal_giant_past_its_reach_lets_a_tesla_go_at_once() {
+    let r = royal_giant_on_a_hiding_tesla(HiddenHoldReach::ProjectileKeepReach, 60);
+    let first = r.iter().position(|x| x.0).expect("precondition: the Tesla went under");
+    assert!(!r[first].1, "projectile_keep_reach: the Royal Giant kept the Tesla under ground: {r:?}");
+}
