+def walk_pin(members, stats, prev, first):
+    """Creation tick of a play's bodies from their first walking step, or None. calibration movement.DEPLOY_TIMING
+    (measured HIGH): a unit is immobile for DeployTime / 50 ticks after its creation tick c and takes its first full step
+    (Speed millitiles) on c + DeployTime / 50. A body standing still on two frames and then d away one frame (<= 3 ticks)
+    later took round(d / Speed) steps, the first on (that frame - steps + 1). diag_night/skel: the frame-gap guess
+    creates the unit on the earlier of the gap's two ticks, so the SIM walked 1 tick ahead of live in 57 of 131 own
+    Skeletons and 18 of 43 Knights. Bodies off an integer step count by > 0.15 (slowed, pushed, attacking) are not used;
+    the earliest qualifying body wins (multi-unit cards with a member deploy delay); it must fall in (prev, first]."""
+    v, D = stats
+    if not v or not D:
+        return None
+    cs = []
+    for r in members:
+        tr = r['traj']
+        for (ta, xa, ya), (tp, xp, yp), (tf, xf, yf) in zip(tr, tr[1:], tr[2:]):
+            if math.hypot(xp-xa, yp-ya) > 5:
+                continue                   # not standing yet (spawn spread / push during the deploy)
+            d = math.hypot(xf-xp, yf-yp)
+            if d <= 20:
+                continue
+            n = round(d / v)
+            if tf - tp <= 3 and 1 <= n <= tf - tp and abs(d / v - n) <= .15:
+                c = tf - n + 1 - D
+                if prev < c <= first:
+                    cs.append(c)
+            break
+    return min(cs) if cs else None
+
