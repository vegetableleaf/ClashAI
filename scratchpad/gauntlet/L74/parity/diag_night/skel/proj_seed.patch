+def in_flight(eng, m, fight, start, catalog, levels, tower_levels):
+    """Ext logs: [dict(side, x, y, tx, ty, src, tgt, tpl)] for the live shots of the t0 frame whose target is a t0-board body
+    or standing tower (unit shots: the projectile's card; tower shots: card -1 and a tower source). Spells are not shots
+    (spell_in_flight_at_start blocks those fights). tpl = the SIM's own shot of that firer (Engine.shot_template; this
+    probes, so call before the fight's reset)."""
+    live0 = {bd['id']: bd for bd in start}
+    t0, i0 = fight['t0'], fight['frame0']
+    born = {}                      # shot id -> first frame seen (a volley = one source's shots first seen together)
+    for t, _ in m['frames'][max(0, i0-40):i0+1]:
+        for p in m['proj'].get(t, ()):
+            born.setdefault(p[6], t)
+    out, volley = [], defaultdict(list)
+    for p in m['proj'].get(t0, ()):
+        side, x, y, cid, tx, ty, _, src, tgt = p
+        if tgt not in live0 or (live0[tgt]['tower'] and live0[tgt]['hp'] <= 0) or live0[tgt]['side'] == side:
+            continue
+        if cid == -1:
+            if not (src in live0 and live0[src]['tower']):
+                continue
+            tpl = eng.shot_template(side, tower='K' if src.endswith('K') else 'P', level=tower_levels[side])
+        else:
+            c = catalog.get(cid)
+            if c is None or c.get('type') == 'spell' or c['display_name'] not in eng.ids:
+                continue
+            body = live0.get(src)
+            form = form_of(body['card_id'], catalog[body['card_id']]) if body and not body['tower'] and body['card_id'] in catalog else form_of(cid, c)
+            name = c['display_name']
+            tpl = eng.shot_template(side, name, form, levels.get((side, name)) or levels.get((side, '*')) or 15)
+        s = dict(side=side, x=x, y=y, tx=tx, ty=ty, src=src if src in live0 else None, tgt=tgt, tpl=tpl and tpl[0],
+                 n=tpl[1] if tpl else 1)
+        volley[src, born.get(p[6], t0), tgt].append(s)
+        out.append(s)
+    # A volley the SIM fires as fewer shots (the Princess: 5 arrow rows live) keeps the rows aimed nearest the target, as
+    # many as the SIM fires.
+    drop = set()
+    for (src, _, tgt), ss in volley.items():
+        keep = ss[0]['n']
+        if len(ss) > keep:
+            b = live0[tgt]
+            drop |= {id(s) for s in sorted(ss, key=lambda s: math.hypot(s['tx']-b['x'], s['ty']-b['y']))[keep:]}
+    return [s for s in out if id(s) not in drop]
+
