+def fired_targets(m, fight, start, look=100):
+    """Ext logs: {live id: {live ids}} -- the t0-board bodies (towers included) a t0-board shooter has launched a projectile
+    at since it acquired its t0 target (a projectile's first sighting = its launch). With phase-3 rows the acquisition is
+    the last tick its target generation changed (within `look` ticks); without them only its latest shot counts."""
+    t0, i0 = fight['t0'], fight['frame0']
+    on = {bd['id'] for bd in start}
+    gen = {bd['id']: bd.get('gen') for bd in start}
+    shots, seen = defaultdict(list), set()
+    for t, _ in m['frames'][max(0, i0-look):i0+1]:
+        if t < t0 - look:
+            continue
+        for p in m['proj'].get(t, ()):
+            if p[6] in seen:
+                continue
+            seen.add(p[6])
+            if p[7] in on and p[8] in on:
+                shots[p[7]].append((t, p[8]))
+    att = m.get('attacks') or {}
+    ts = sorted(t for t in att if t0 - look <= t <= t0)
+    out = {}
+    for k, ss in shots.items():
+        g = gen.get(k)
+        rows = [(t, att[t][g][0]) for t in ts if g is not None and g in att[t]]
+        if not rows:
+            out[k] = {max(ss)[1]}
+            continue
+        cur, acq = rows[-1][1], t0 - look
+        for t, tg in reversed(rows):
+            if tg != cur:
+                acq = t; break
+        tg_ids = {bd for bd in on if gen.get(bd) is not None and gen[bd] == cur}
+        hit = {v for t, v in ss if t > acq and v in tg_ids}
+        if hit:
+            out[k] = hit
+    return out
+
