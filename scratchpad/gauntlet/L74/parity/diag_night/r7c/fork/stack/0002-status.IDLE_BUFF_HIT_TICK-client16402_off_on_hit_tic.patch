@@ -0,0 +1,85 @@
+//! status.IDLE_BUFF_HIT_TICK: a unit's own idle buff (status.IDLE_BUFF; the Evo Knight's Knight_Fortify_EV1, DamageReduction
+//! 60) is off for the hits that land on the tick of the unit's own hit (combat.rs `damage_reduction_of`).
+//!
+//! THE READING (client 16.402 live frames, ClashBot parity diag_night/r6c ekhit.py): 7 of 7 mirror duels (an enemy whose
+//! attack clock reads the Evo Knight's on every tick, so both hits land on one tick) took the enemy's whole hit on it,
+//! the reduction on until the frame before; liveplay 20261017_050051 t3053 two Evo Knights take 293 and 323 off each other.
+//!
+//! The scene: a blue Evo Knight (level 11) put down, a red Knight (level 11) held out of sight until its deploy ends, then
+//! both on points inside their reach, kept there and topped up: both swings land on one tick; the first hp losses.
+//!
+//! PLANT (regression): idle_buff_reduces_own_hit_tick -> `a_hit_landing_with_the_evo_knights_own_is_taken_whole` red.
+//!   RUSTFLAGS='--cfg clash_plant="idle_buff_reduces_own_hit_tick"' CARGO_TARGET_DIR=target/plant cargo test --profile
+//!   gate --test idle_buff_hit_tick
+#![allow(unexpected_cfgs)]
+mod common;
+
+use royalesim::card::CardDb;
+use royalesim::fixed::{Vec2, SUBTILE_PER_MILLITILE as K};
+use royalesim::state::{BattleConfig, BattleState, Calib, CardTable, IdleBuffHitTick};
+use royalesim::Team;
+
+fn n(x: i32, y: i32) -> Vec2 {
+    Vec2::new(x * K, y * K)
+}
+
+/// (the blue Evo Knight's first hp loss, the red Knight's first hp loss, whether they were on one tick). Blue's princess
+/// towers down (its king's reach stops short of y 12000, as tests/evo_mega_knight.rs's scene): no tower in the trade.
+fn first_trade(arm: IdleBuffHitTick) -> (i32, i32, bool) {
+    let mut cfg = BattleConfig::with_cards(CardDb::load_table(CardTable::Client160402017).expect("the 160402017 table"));
+    cfg.calib.card_table = CardTable::Client160402017;
+    cfg.calib.idle_buff_hit_tick = arm;
+    cfg.decks = [vec!["Knight".into(), "Archer".into()], vec!["Knight".into()]];
+    cfg.forms = [vec![1, 0], Vec::new()];
+    cfg.card_level = [11, 11];
+    cfg.tower_level = [11, 11];
+    let mut s = BattleState::new(7, cfg);
+    common::past_deploy_lockout(&mut s);
+    let towers: Vec<_> = s.entities().filter(|e| e.team == Team::Blue && e.kind == royalesim::entity::EntityKind::PrincessTower).map(|e| e.id).collect();
+    for t in towers {
+        assert!(s.debug_set_hp(t, 0));
+    }
+    s.tick();
+    s.tick();
+    let (b_at, r_at, away) = (n(9000, 12500), n(9000, 13900), n(9000, 22500));
+    s.spawn_unit(Team::Blue, "Knight_EV1", b_at, None).expect("the Evo Knight");
+    let red = s.scenario_spawn_now(Team::Red, "Knight", away, None).expect("a red Knight");
+    s.tick();
+    let blue = common::find_live(&s, Team::Blue, "Knight_EV1")[0].id;
+    let (mut lb, mut lr) = (None, None);
+    for k in 0..200u32 {
+        let out = s.entity(blue).expect("the Evo Knight").deploying;
+        assert!(s.debug_set_pos(blue, b_at) && s.debug_set_pos(red, if out { away } else { r_at }));
+        let (tb, tr) = (s.entity(blue).unwrap().max_hp, s.entity(red).unwrap().max_hp);
+        assert!(s.debug_set_hp(blue, tb) && s.debug_set_hp(red, tr));
+        s.tick();
+        let (hb, hr) = (s.entity(blue).expect("the Evo Knight").hp, s.entity(red).expect("the red Knight").hp);
+        if lb.is_none() && hb < tb {
+            lb = Some((k, tb - hb));
+        }
+        if lr.is_none() && hr < tr {
+            lr = Some((k, tr - hr));
+        }
+        if let (Some((kb, db)), Some((kr, dr))) = (lb, lr) {
+            return (db, dr, kb == kr);
+        }
+    }
+    panic!("{arm:?}: the scene drifted: no trade of hits");
+}
+
+/// Plant: idle_buff_reduces_own_hit_tick.
+#[test]
+fn a_hit_landing_with_the_evo_knights_own_is_taken_whole() {
+    let (blue, red, together) = first_trade(IdleBuffHitTick::Client16402OffOnHitTick);
+    assert!(together, "the scene drifted: the two first hits were not on one tick ({blue}, {red})");
+    assert_eq!(blue, red, "client16402_off_on_hit_tick: the Evo Knight took {blue} on its own hit tick, the red Knight {red}");
+    // NOT VACUOUS: the engine's arm reduces it (60 %).
+    let (old, red_old, _) = first_trade(IdleBuffHitTick::StartOfTick);
+    assert_eq!(red_old, red, "the red Knight's hit changed with the arm");
+    assert!(old < blue && old == (red * 40) / 100, "start_of_tick: the Evo Knight took {old}, not 40 % of {red}");
+}
+
+#[test]
+fn the_shipped_arm_is_off_on_the_hit_tick() {
+    assert_eq!(Calib::shipped().idle_buff_hit_tick, IdleBuffHitTick::Client16402OffOnHitTick);
+}
