+//! status.BUFF_PULSE_REDUCTION: a buff's own damage pulse (Poison, Tornado, Earthquake) takes its target's DamageReduction
+//! twice: as `buff_pulse_pass` deals it and again in Resolve.
+//!
+//! THE READING (client 16.402 live frames, ClashBot parity diag_night/r7c poisoncen.py / dotsum.py): a Poison pulse took
+//! 21 / 23 off an Evo Knight with its Knight_Fortify_EV1 row on (17 clean pulses, 8 battles) and 133 / 147 off the Ice
+//! Wizards under the same cloud on the same frames: 133 -> 53 -> 21, 147 -> 58 -> 23.
+//!
+//! The scene: a blue Evo Knight (level 11) put down with nothing to fight and kept on its point, a red Poison on it; its
+//! first pulse against the same pulse on a plain blue Knight.
+//!
+//! PLANT (regression): buff_pulse_reduced_once -> `a_poison_pulse_takes_the_evo_knights_reduction_twice` red.
+//!   RUSTFLAGS='--cfg clash_plant="buff_pulse_reduced_once"' CARGO_TARGET_DIR=target/plant cargo test --profile gate
+//!   --test buff_pulse_reduction
+#![allow(unexpected_cfgs)]
+mod common;
+
+use royalesim::card::CardDb;
+use royalesim::fixed::{Vec2, SUBTILE_PER_MILLITILE as K};
+use royalesim::state::{BattleConfig, BattleState, BuffPulseReduction, Calib, CardTable};
+use royalesim::Team;
+
+fn n(x: i32, y: i32) -> Vec2 {
+    Vec2::new(x * K, y * K)
+}
+
+/// The first Poison pulse a blue `card` (Knight_EV1 or Knight) takes, kept on a point out of every tower's reach.
+fn first_pulse(arm: BuffPulseReduction, card: &str) -> i32 {
+    let mut cfg = BattleConfig::with_cards(CardDb::load_table(CardTable::Client160402017).expect("the 160402017 table"));
+    cfg.calib.card_table = CardTable::Client160402017;
+    cfg.calib.buff_pulse_reduction = arm;
+    cfg.decks = [vec!["Knight".into(), "Archer".into()], vec!["Poison".into()]];
+    cfg.forms = [vec![1, 0], Vec::new()];
+    cfg.card_level = [11, 11];
+    cfg.tower_level = [11, 11];
+    let mut s = BattleState::new(7, cfg);
+    common::past_deploy_lockout(&mut s);
+    let at = n(9000, 14500);
+    s.spawn_unit(Team::Blue, card, at, None).expect("the blue Knight");
+    s.tick();
+    let blue = common::find_live(&s, Team::Blue, card)[0].id;
+    for _ in 0..40 {
+        assert!(s.debug_set_pos(blue, at));
+        s.tick();
+    }
+    let top = s.entity(blue).expect("the Knight").max_hp;
+    assert!(s.debug_set_hp(blue, top));
+    s.spawn_unit(Team::Red, "Poison", at, None).expect("cast Poison");
+    for _ in 0..80 {
+        assert!(s.debug_set_pos(blue, at));
+        s.tick();
+        let hp = s.entity(blue).expect("the Knight").hp;
+        if hp < top {
+            return top - hp;
+        }
+    }
+    panic!("{arm:?} {card}: the Poison never pulsed");
+}
+
+/// Plant: buff_pulse_reduced_once.
+#[test]
+fn a_poison_pulse_takes_the_evo_knights_reduction_twice() {
+    let whole = first_pulse(BuffPulseReduction::Client16402Twice, "Knight");
+    assert_eq!(whole, first_pulse(BuffPulseReduction::Once, "Knight"), "a plain Knight's pulse moved with the arm");
+    let twice = first_pulse(BuffPulseReduction::Client16402Twice, "Knight_EV1");
+    let once = first_pulse(BuffPulseReduction::Once, "Knight_EV1");
+    // NOT VACUOUS: the engine's arm takes the 60 % once.
+    assert_eq!(once, (whole * 40) / 100, "once: the Evo Knight took {once} of a {whole} pulse");
+    assert_eq!(twice, (once * 40) / 100, "client16402_twice: the Evo Knight took {twice} of a {whole} pulse (once {once})");
+}
+
+#[test]
+fn the_shipped_arm_reduces_a_pulse_twice() {
+    assert_eq!(Calib::shipped().buff_pulse_reduction, BuffPulseReduction::Client16402Twice);
+}
