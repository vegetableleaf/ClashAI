# --- Virtual environments (huge; recreate from requirements.txt) ---
.venv/
venv/
env/
ENV/

# --- Python caches ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- Recordings, datasets & trained weights (large / regenerable) ---
# Gameplay videos, labeled datasets, and policy checkpoints live under data/.
data/
*.mp4
*.avi
*.mkv

# --- Label Studio exports & detector training output (transient working artifacts) ---
annotation_export*/
runs/

# --- Scratch / diagnostics ---
**/tmp_*.py
**/diag_*.png
**/_cand_*.png
**/_candidates.png

# --- OS cruft ---
.DS_Store
Thumbs.db
desktop.ini

# --- Card reference pictures (third-party art, regenerable) ---
# `run.py cards-art` re-downloads these from the Fandom wiki whenever they are needed.
# Not committed: they are someone else's images and cost ~2.6 MB.
icebow/templates/cardart/

# --- Stale push worktrees + root-level model weights (large / regenerable) ---
_push_worktree/
*.pt

# Kept on purpose (small + needed): src/**/hp_digits.npz, templates/**/*.png
data/webcache/

# --- Graphify knowledge-graph output (regenerable; can embed file contents) ---
# graph.json/graph.html hold extracted code structure and text, so a committed graph is a second
# copy of the repo that no one reviews. Regenerate with `/graphify .` instead of committing it.
graphify-out/
raw/

# scratch probes written during diagnosis
s_tmp.py
align_tmp.py
wr_eval_tmp.py
